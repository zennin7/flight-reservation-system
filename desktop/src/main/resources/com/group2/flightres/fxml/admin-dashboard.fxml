<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.AdminDashboardController"
                 photoPath="/images/destinations/cpt.jpg"
                 blurRadius="26.0"
                 darkness="-0.50"
                 saturation="0.20"
                 enableSecondaryGlow="true"
                 stylesheets="@../css/glass.css"
                 styleClass="seat-map-glass-root"
                 prefWidth="1280"
                 prefHeight="800"
                 minWidth="900"
                 minHeight="680">

    <VBox alignment="TOP_CENTER" spacing="0" prefWidth="1280" prefHeight="800" VBox.vgrow="ALWAYS">

        <!-- TOP NAV -->
        <HBox fx:id="topNavBar" alignment="CENTER_LEFT" prefHeight="64" minHeight="64" maxHeight="64" styleClass="glass-nav-bar">
            <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleNavHome" styleClass="admin-nav-brand-wrap" focusTraversable="true">
                <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" styleClass="nav-brand-plane"/>
                <Label styleClass="nav-brand-text">
                    <text><BrandConfig fx:constant="APP_NAME"/></text>
                </Label>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox fx:id="adminNavLinksBox" alignment="CENTER" spacing="28" styleClass="glass-nav-links-box">
                <Button fx:id="navDashboardBtn" text="Dashboard" styleClass="glass-nav-link, glass-nav-link-active" onAction="#handleRefresh"/>
                <Button fx:id="navFlightsBtn" text="Flights" styleClass="glass-nav-link" onAction="#handleNavFlights"/>
                <Button fx:id="navBookingsBtn" text="Bookings" styleClass="glass-nav-link" onAction="#handleNavBookings"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="10" prefWidth="140">
                <Label fx:id="roleBadgeLabel" text="ADMIN" styleClass="badge, badge-gold"/>
                <StackPane fx:id="avatarCircle" styleClass="glass-avatar-circle" onMouseClicked="#handleNavAvatar" focusTraversable="true">
                    <Label fx:id="avatarInitialsLabel" text="AD" styleClass="glass-avatar-text"/>
                </StackPane>
            </HBox>
        </HBox>

        <!-- MAIN CONTENT GLASS CARD -->
        <StackPane fx:id="cardMarginWrapper" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="4" bottom="20" left="56" right="56"/>
            </VBox.margin>

            <VBox fx:id="mainContainer" spacing="14" styleClass="glass-card, admin-main-card" VBox.vgrow="ALWAYS">

                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="dashboardTitleLabel" text="Admin Dashboard" styleClass="headline-serif"/>
                        <Label fx:id="dashboardSubtitleLabel" text="Live platform revenue, load factors, and seat availability alerts." styleClass="subheadline"/>
                    </VBox>
                    <Button fx:id="refreshButton" text="Refresh" styleClass="btn-ghost" onAction="#handleRefresh"/>
                </HBox>

                <!-- State Stack -->
                <StackPane fx:id="contentStack" VBox.vgrow="ALWAYS">

                    <!-- 1. POPULATED STATE -->
                    <ScrollPane fx:id="dashboardScrollPane"
                                styleClass="confirmation-scroll-pane"
                                fitToWidth="true"
                                fitToHeight="false"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                VBox.vgrow="ALWAYS">
                        <VBox fx:id="populatedContainer" spacing="14" VBox.vgrow="ALWAYS">

                            <!-- KPI Row -->
                            <HBox fx:id="kpiRow" spacing="14">
                                <VBox styleClass="admin-kpi-card" HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="Total Revenue (Confirmed)" styleClass="admin-kpi-label"/>
                                    <Label fx:id="totalRevenueLabel" text="R 0.00" styleClass="admin-kpi-value-gold"/>
                                </VBox>
                                <VBox styleClass="admin-kpi-card" HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="Confirmed Bookings" styleClass="admin-kpi-label"/>
                                    <Label fx:id="bookingsCountLabel" text="0" styleClass="admin-kpi-value"/>
                                </VBox>
                                <VBox styleClass="admin-kpi-card" HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="Tickets Sold" styleClass="admin-kpi-label"/>
                                    <Label fx:id="ticketsSoldLabel" text="0" styleClass="admin-kpi-value"/>
                                </VBox>
                                <VBox styleClass="admin-kpi-card" HBox.hgrow="ALWAYS" spacing="4">
                                    <Label text="Low-Seat Alerts" styleClass="admin-kpi-label"/>
                                    <Label fx:id="lowSeatCountLabel" text="0" styleClass="admin-kpi-value"/>
                                </VBox>
                            </HBox>

                            <!-- Charts Row -->
                            <HBox fx:id="chartsRow" spacing="14" prefHeight="250" minHeight="220">
                                <VBox styleClass="admin-panel-card" HBox.hgrow="ALWAYS" spacing="6" prefWidth="600">
                                    <Label text="BOOKINGS PER DAY (LAST 14 DAYS · SAST)" styleClass="admin-section-title"/>
                                    <BarChart fx:id="bookingsPerDayChart" styleClass="admin-bar-chart" VBox.vgrow="ALWAYS"
                                              legendVisible="false" animated="false"
                                              horizontalGridLinesVisible="true" verticalGridLinesVisible="false"
                                              categoryGap="8">
                                        <xAxis>
                                            <CategoryAxis fx:id="xAxis" tickMarkVisible="false"/>
                                        </xAxis>
                                        <yAxis>
                                            <NumberAxis fx:id="yAxis" minorTickVisible="false" autoRanging="true"/>
                                        </yAxis>
                                    </BarChart>
                                </VBox>

                                <VBox styleClass="admin-panel-card" spacing="6" prefWidth="310" minWidth="240">
                                    <Label text="REVENUE SHARE BY ROUTE" styleClass="admin-section-title"/>
                                    <PieChart fx:id="revenueByRouteChart" styleClass="admin-pie-chart" VBox.vgrow="ALWAYS"
                                              animated="false" labelsVisible="true" legendVisible="true"/>
                                </VBox>
                            </HBox>

                            <!-- Bottom Row: Upcoming Flights Load Factor + Low-Seat Alerts -->
                            <HBox fx:id="tablesRow" spacing="14">
                                <VBox styleClass="admin-panel-card" HBox.hgrow="ALWAYS" spacing="8" prefWidth="600">
                                    <Label text="UPCOMING FLIGHTS &amp; LOAD FACTOR" styleClass="admin-section-title"/>
                                    <VBox fx:id="upcomingFlightsContainer" spacing="8"/>
                                </VBox>

                                <VBox styleClass="admin-panel-card" spacing="8" prefWidth="310" minWidth="240">
                                    <Label fx:id="lowSeatTitleLabel" text="LOW-SEAT ALERTS" styleClass="admin-section-title"/>
                                    <VBox fx:id="lowSeatAlertsContainer" spacing="8"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </ScrollPane>

                    <!-- 2. EMPTY STATE -->
                    <VBox fx:id="emptyStateContainer" alignment="CENTER" spacing="14" visible="false" managed="false"
                          styleClass="admin-state-box">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56" styleClass="admin-empty-circle">
                            <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" styleClass="nav-brand-plane"/>
                        </StackPane>
                        <Label fx:id="emptyTitleLabel" text="No platform activity yet" styleClass="headline-serif"/>
                        <Label fx:id="emptySubtitleLabel" text="Confirmed bookings and scheduled upcoming flights will populate here." styleClass="subheadline"/>
                    </VBox>

                    <!-- 3. ERROR STATE -->
                    <VBox fx:id="errorStateContainer" alignment="CENTER" spacing="14" visible="false" managed="false"
                          styleClass="admin-state-box">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56" styleClass="admin-error-circle">
                            <Label text="!" styleClass="admin-error-glyph"/>
                        </StackPane>
                        <Label fx:id="errorTitleLabel" text="Unable to load dashboard" styleClass="headline-serif"/>
                        <Label fx:id="errorMessageLabel" text="Could not retrieve platform metrics. Please try again." styleClass="subheadline"/>
                        <Button fx:id="retryButton" text="Retry" styleClass="btn-gold" onAction="#handleRetry" prefWidth="180"/>
                    </VBox>

                    <!-- 4. DENIED STATE (RBAC) -->
                    <VBox fx:id="deniedStateContainer" alignment="CENTER" spacing="14" visible="false" managed="false"
                          styleClass="admin-state-box">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56" styleClass="admin-error-circle">
                            <Label text="!" styleClass="admin-error-glyph"/>
                        </StackPane>
                        <Label fx:id="deniedTitleLabel" text="Access denied" styleClass="headline-serif"/>
                        <Label fx:id="deniedMessageLabel" text="Administrator privileges are required to view the Admin Dashboard." styleClass="subheadline"/>
                        <Button fx:id="backHomeButton" text="Back to Home" styleClass="btn-gold" onAction="#handleNavHome" prefWidth="180"/>
                    </VBox>

                </StackPane>
            </VBox>
        </StackPane>
    </VBox>
</GlassBackground>
