<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.component.TicketView?>
<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.AdminBookingsController"
                 photoPath="/images/destinations/cpt.jpg"
                 blurRadius="26.0"
                 darkness="-0.50"
                 saturation="0.20"
                 enableSecondaryGlow="true"
                 stylesheets="@../css/glass.css"
                 styleClass="seat-map-glass-root"
                 prefWidth="1280"
                 prefHeight="800"
                 minWidth="900"
                 minHeight="680">

    <VBox alignment="TOP_CENTER" spacing="0" prefWidth="1280" prefHeight="800" VBox.vgrow="ALWAYS">

        <!-- TOP NAV -->
        <HBox alignment="CENTER_LEFT" prefHeight="64" minHeight="64" maxHeight="64" styleClass="glass-nav-bar">
            <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleNavHome" styleClass="admin-nav-brand-wrap" focusTraversable="true">
                <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" styleClass="nav-brand-plane"/>
                <Label styleClass="nav-brand-text">
                    <text><BrandConfig fx:constant="APP_NAME"/></text>
                </Label>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox fx:id="adminNavLinksBox" alignment="CENTER" spacing="28" styleClass="glass-nav-links-box">
                <Button fx:id="navDashboardBtn" text="Dashboard" styleClass="glass-nav-link" onAction="#handleNavDashboard"/>
                <Button fx:id="navFlightsBtn" text="Flights" styleClass="glass-nav-link" onAction="#handleNavFlights"/>
                <Button fx:id="navBookingsBtn" text="Bookings" styleClass="glass-nav-link, glass-nav-link-active" onAction="#handleRefresh"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="10" prefWidth="140">
                <Label fx:id="roleBadgeLabel" text="ADMIN" styleClass="badge, badge-gold"/>
                <StackPane fx:id="avatarCircle" styleClass="glass-avatar-circle" onMouseClicked="#handleNavAvatar" focusTraversable="true">
                    <Label fx:id="avatarInitialsLabel" text="AD" styleClass="glass-avatar-text"/>
                </StackPane>
            </HBox>
        </HBox>

        <!-- MAIN CONTENT GLASS CARD -->
        <StackPane fx:id="cardMarginWrapper" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="4" bottom="20" left="56" right="56"/>
            </VBox.margin>

            <VBox fx:id="mainContainer" spacing="12" styleClass="glass-card, admin-main-card" VBox.vgrow="ALWAYS">

                <!-- Header + Server-Side Search -->
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="pageTitleLabel" text="Admin Bookings" styleClass="headline-serif"/>
                        <Label fx:id="pageSubtitleLabel" text="Search reservations by PNR, email or passenger and inspect boarding passes." styleClass="subheadline"/>
                    </VBox>
                    <TextField fx:id="searchField" promptText="PNR, email or name..." prefWidth="250" onAction="#handleSearch"/>
                    <Button fx:id="searchButton" text="Search" styleClass="btn-gold" onAction="#handleSearch"/>
                </HBox>

                <!-- Filter Bar + Aggregate Summary -->
                <HBox fx:id="filterBar" alignment="CENTER_LEFT" spacing="10">
                    <Button fx:id="filterAllBtn" text="All" styleClass="admin-filter-pill-active" onAction="#handleFilterAll"/>
                    <Button fx:id="filterConfirmedBtn" text="Confirmed" styleClass="admin-filter-pill" onAction="#handleFilterConfirmed"/>
                    <Button fx:id="filterCancelledBtn" text="Cancelled" styleClass="admin-filter-pill" onAction="#handleFilterCancelled"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="summaryStatsLabel" text="0 bookings · R 0.00" styleClass="admin-row-gold"/>
                </HBox>

                <!-- State Stack -->
                <StackPane fx:id="contentStack" VBox.vgrow="ALWAYS">

                    <!-- 1. POPULATED STATE: Table + Ticket Detail Drawer -->
                    <HBox fx:id="splitBody" spacing="14" VBox.vgrow="ALWAYS">

                        <!-- Left: Joined Bookings Table + Pagination -->
                        <VBox styleClass="admin-panel-card" HBox.hgrow="ALWAYS" spacing="8" VBox.vgrow="ALWAYS">
                            <HBox spacing="10" styleClass="admin-table-header">
                                <Label text="PNR" styleClass="admin-section-title" minWidth="72"/>
                                <Label text="PASSENGER" styleClass="admin-section-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label text="ROUTE" styleClass="admin-section-title" minWidth="88"/>
                                <Label text="DEPARTURE" styleClass="admin-section-title" minWidth="122"/>
                                <Label text="SEAT" styleClass="admin-section-title" minWidth="44"/>
                                <Label text="TOTAL" styleClass="admin-section-title" minWidth="82"/>
                                <Label text="STATUS" styleClass="admin-section-title" minWidth="84"/>
                            </HBox>

                            <ScrollPane fx:id="tableScrollPane"
                                        styleClass="confirmation-scroll-pane"
                                        fitToWidth="true"
                                        fitToHeight="false"
                                        hbarPolicy="AS_NEEDED"
                                        vbarPolicy="AS_NEEDED"
                                        VBox.vgrow="ALWAYS">
                                <VBox fx:id="rowsContainer" spacing="6"/>
                            </ScrollPane>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="paginationLabel" text="Page 1 of 1" styleClass="admin-row-meta"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="prevPageButton" text="Previous" styleClass="btn-ghost" onAction="#handlePrevPage"/>
                                <Button fx:id="nextPageButton" text="Next" styleClass="btn-ghost" onAction="#handleNextPage"/>
                            </HBox>
                        </VBox>

                        <!-- Right: Detail Drawer with Reusable TicketView -->
                        <VBox fx:id="detailDrawer" styleClass="admin-panel-card" spacing="10" prefWidth="350" minWidth="290">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="BOOKING TICKET DETAIL" styleClass="admin-section-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                <Label fx:id="selectedPnrLabel" text="" styleClass="admin-row-gold"/>
                            </HBox>
                            <TicketView fx:id="ticketView"/>
                            <Label fx:id="drawerPlaceholderLabel" text="Select a booking row to inspect its boarding pass." styleClass="admin-row-meta" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <!-- 2. EMPTY STATE -->
                    <VBox fx:id="emptyStateContainer" alignment="CENTER" spacing="14" visible="false" managed="false"
                          styleClass="admin-state-box">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56" styleClass="admin-empty-circle">
                            <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" styleClass="nav-brand-plane"/>
                        </StackPane>
                        <Label fx:id="emptyTitleLabel" text="No bookings found" styleClass="headline-serif"/>
                        <Label fx:id="emptySubtitleLabel" text="No reservations match your current search or status filter." styleClass="subheadline"/>
                        <Button fx:id="resetFiltersButton" text="Reset filters" styleClass="btn-gold" onAction="#handleResetFilters" prefWidth="180"/>
                    </VBox>

                    <!-- 3. ERROR STATE -->
                    <VBox fx:id="errorStateContainer" alignment="CENTER" spacing="14" visible="false" managed="false"
                          styleClass="admin-state-box">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56" styleClass="admin-error-circle">
                            <Label text="!" styleClass="admin-error-glyph"/>
                        </StackPane>
                        <Label fx:id="errorTitleLabel" text="Unable to load bookings" styleClass="headline-serif"/>
                        <Label fx:id="errorMessageLabel" text="Could not retrieve bookings list. Please try again." styleClass="subheadline"/>
                        <Button fx:id="retryButton" text="Retry" styleClass="btn-gold" onAction="#handleRetry" prefWidth="180"/>
                    </VBox>

                    <!-- 4. DENIED STATE (RBAC) -->
                    <VBox fx:id="deniedStateContainer" alignment="CENTER" spacing="14" visible="false" managed="false"
                          styleClass="admin-state-box">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56" styleClass="admin-error-circle">
                            <Label text="!" styleClass="admin-error-glyph"/>
                        </StackPane>
                        <Label fx:id="deniedTitleLabel" text="Access denied" styleClass="headline-serif"/>
                        <Label fx:id="deniedMessageLabel" text="Administrator privileges are required to view Admin Bookings." styleClass="subheadline"/>
                        <Button fx:id="backHomeButton" text="Back to Home" styleClass="btn-gold" onAction="#handleNavHome" prefWidth="180"/>
                    </VBox>

                </StackPane>
            </VBox>
        </StackPane>
    </VBox>
</GlassBackground>
