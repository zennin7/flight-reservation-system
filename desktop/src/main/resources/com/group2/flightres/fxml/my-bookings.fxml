<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.MyBookingsController"
                 photoPath="/images/destinations/cpt.jpg"
                 blurRadius="26.0"
                 darkness="-0.50"
                 saturation="0.20"
                 linearOverlay="linear-gradient(to bottom, rgba(11,18,32,0.40) 0%, rgba(11,18,32,0.74) 100%)"
                 radialGlow="radial-gradient(center 80% 0%, radius 45%, rgba(212,166,60,0.16) 0%, transparent 100%)"
                 enableSecondaryGlow="true"
                 stylesheets="@../css/glass.css"
                 styleClass="seat-map-glass-root"
                 prefWidth="1280"
                 prefHeight="800"
                 minWidth="900"
                 minHeight="680">

    <VBox alignment="TOP_CENTER" spacing="0" prefWidth="1280" prefHeight="800" VBox.vgrow="ALWAYS">

        <!-- ===================================================================
             TOP NAV (64 high, padding 0 56)
             =================================================================== -->
        <HBox alignment="CENTER_LEFT" prefHeight="64" minHeight="64" maxHeight="64" styleClass="glass-nav-bar">
            <!-- Brand: gold plane icon + BrandConfig.APP_NAME -->
            <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleNavHome" style="-fx-cursor: hand;" focusTraversable="true">
                <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" styleClass="nav-brand-plane"/>
                <Label styleClass="nav-brand-text">
                    <text><BrandConfig fx:constant="APP_NAME"/></text>
                </Label>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Center nav links: Flights, My Bookings (active), Offers, About, Contact -->
            <HBox alignment="CENTER" spacing="30" styleClass="glass-nav-links-box">
                <Button fx:id="navFlightsBtn" text="Flights" styleClass="glass-nav-link" onAction="#handleNavFlights"/>
                <Button fx:id="navMyBookingsBtn" text="My Bookings" styleClass="glass-nav-link, glass-nav-link-active" onAction="#handleNavMyBookings"/>
                <Button fx:id="navOffersBtn" text="Offers" styleClass="glass-nav-link" onAction="#handleComingSoonOffers"/>
                <Button fx:id="navAboutBtn" text="About" styleClass="glass-nav-link" onAction="#handleNavAbout"/>
                <Button fx:id="navContactBtn" text="Contact" styleClass="glass-nav-link" onAction="#handleNavContact"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- User avatar -->
            <HBox alignment="CENTER_RIGHT" prefWidth="100">
                <StackPane fx:id="avatarCircle" styleClass="glass-avatar-circle" onMouseClicked="#handleNavAvatar" style="-fx-cursor: hand;" focusTraversable="true">
                    <Label fx:id="avatarInitialsLabel" text="DT" styleClass="glass-avatar-text"/>
                </StackPane>
            </HBox>
        </HBox>

        <!-- ===================================================================
             MAIN CONTENT GLASS CARD (Margin 4 56 20 56)
             =================================================================== -->
        <StackPane fx:id="cardMarginWrapper" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="4" bottom="20" left="56" right="56"/>
            </VBox.margin>

            <!-- Main Glass Card Container -->
            <VBox fx:id="mainContainer" spacing="16" styleClass="glass-card" style="-fx-padding: 24 32 24 32;" VBox.vgrow="ALWAYS">

                <!-- Header Block: Headline + Subtitle -->
                <VBox spacing="4">
                    <Label fx:id="dashboardTitleLabel" text="My Bookings" styleClass="headline-serif"/>
                    <Label fx:id="dashboardSubtitleLabel" text="Manage your upcoming journeys, view boarding passes, and browse past trips." styleClass="subheadline"/>
                </VBox>

                <!-- Tab Pills Bar -->
                <HBox fx:id="tabsBar" spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 4 0 8 0;">
                    <Button fx:id="upcomingTabBtn" text="Upcoming (0)" onAction="#handleShowUpcoming"
                            style="-fx-background-radius: 999px; -fx-padding: 8 18; -fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-cursor: hand;"/>
                    <Button fx:id="pastTabBtn" text="Past (0)" onAction="#handleShowPast"
                            style="-fx-background-radius: 999px; -fx-padding: 8 18; -fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-cursor: hand;"/>
                    <Button fx:id="cancelledTabBtn" text="Cancelled (0)" onAction="#handleShowCancelled"
                            style="-fx-background-radius: 999px; -fx-padding: 8 18; -fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-cursor: hand;"/>
                </HBox>

                <!-- Content Area: Switch between Populated, Empty, and Error states -->
                <StackPane fx:id="contentStack" VBox.vgrow="ALWAYS">

                    <!-- 1. POPULATED STATE (Scrollable booking cards) -->
                    <ScrollPane fx:id="bookingsScrollPane"
                                styleClass="confirmation-scroll-pane"
                                fitToWidth="true"
                                fitToHeight="false"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                VBox.vgrow="ALWAYS">
                        <VBox fx:id="cardsContainer" spacing="14" alignment="TOP_CENTER" VBox.vgrow="ALWAYS"
                              style="-fx-padding: 4 10 16 0; -fx-background-color: transparent;">
                            <!-- Populated dynamically with booking cards -->
                        </VBox>
                    </ScrollPane>

                    <!-- 2. EMPTY STATE -->
                    <VBox fx:id="emptyStateContainer" alignment="CENTER" spacing="16" visible="false" managed="false"
                          style="-fx-padding: 60 20 60 20;" VBox.vgrow="ALWAYS">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56"
                                   style="-fx-background-color: rgba(212, 166, 60, 0.15); -fx-background-radius: 999px; -fx-border-color: rgba(212, 166, 60, 0.40); -fx-border-radius: 999px;">
                            <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" style="-fx-stroke: #d4a63c; -fx-stroke-width: 2.2; -fx-fill: transparent;"/>
                        </StackPane>
                        <Label fx:id="emptyTitleLabel" text="No trips yet" styleClass="headline-serif" style="-fx-font-size: 24px;"/>
                        <Label fx:id="emptySubtitleLabel" text="When you book a flight, your tickets and trip details will appear here." styleClass="subheadline"/>
                        <Button fx:id="searchFlightsButton" text="Search flights" styleClass="btn-gold" onAction="#handleSearchFlights" prefWidth="200"/>
                    </VBox>

                    <!-- 3. ERROR STATE -->
                    <VBox fx:id="errorStateContainer" alignment="CENTER" spacing="16" visible="false" managed="false"
                          style="-fx-padding: 60 20 60 20;" VBox.vgrow="ALWAYS">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56"
                                   style="-fx-background-color: rgba(239, 68, 68, 0.20); -fx-background-radius: 999px; -fx-border-color: rgba(239, 68, 68, 0.50); -fx-border-radius: 999px;">
                            <Label text="!" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #ef4444;"/>
                        </StackPane>
                        <Label fx:id="errorTitleLabel" text="Unable to load bookings" styleClass="headline-serif" style="-fx-font-size: 24px;"/>
                        <Label fx:id="errorMessageLabel" text="We encountered an issue retrieving your booking history. Please try again." styleClass="subheadline"/>
                        <Button fx:id="retryButton" text="Retry" styleClass="btn-gold" onAction="#handleRetry" prefWidth="180"/>
                    </VBox>

                </StackPane>

            </VBox>
        </StackPane>
    </VBox>

</GlassBackground>
