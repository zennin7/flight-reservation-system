<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.component.GlassTopBar?>
<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.MyBookingsController"
                 photoPath="/com/group2/flightres/photos/evgeni-tcherkasski-_-tEJGpBS5w-unsplash.jpg"
                 blurRadius="0.0"
                 darkness="0.0"
                 saturation="0.0"
                 enableSecondaryGlow="false"
                 stylesheets="@../css/glass.css"
                 styleClass="seat-map-glass-root"
                 prefWidth="1280"
                 prefHeight="800"
                 minWidth="1024"
                 minHeight="700">

    <VBox alignment="TOP_CENTER" spacing="0" prefWidth="1280" prefHeight="800" VBox.vgrow="ALWAYS">

        <!-- ===================================================================
             TOP NAV (64 high, web-parity GlassTopBar)
             =================================================================== -->
        <GlassTopBar fx:id="topBar" activeNav="my-bookings"/>

        <!-- ===================================================================
             MAIN CONTENT GLASS CARD (Margin 4 56 20 56)
             =================================================================== -->
        <StackPane fx:id="cardMarginWrapper" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="4" bottom="20" left="56" right="56"/>
            </VBox.margin>

            <!-- Main Glass Card Container -->
            <VBox fx:id="mainContainer" spacing="14" styleClass="glass-card" style="-fx-padding: 20 26 20 26;" VBox.vgrow="ALWAYS">

                <!-- Header Block: Title + Filter Chips Row (Web Traveller Portal header) -->
                <HBox alignment="CENTER_LEFT" spacing="14" styleClass="mb-header-bar">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Traveller Portal" styleClass="mb-kicker"/>
                        <Label fx:id="dashboardTitleLabel" text="My bookings" styleClass="headline-serif"/>
                        <Label fx:id="dashboardSubtitleLabel" text="Manage your upcoming journeys, view boarding passes, and browse past trips." styleClass="subheadline" wrapText="true"/>
                    </VBox>

                    <!-- Tab Pills Bar -->
                    <HBox fx:id="tabsBar" spacing="8" alignment="CENTER_RIGHT" minWidth="-Infinity">
                        <Button fx:id="upcomingTabBtn" text="Upcoming (0)" onAction="#handleShowUpcoming" minWidth="-Infinity" styleClass="mb-tab-chip"/>
                        <Button fx:id="pastTabBtn" text="Past (0)" onAction="#handleShowPast" minWidth="-Infinity" styleClass="mb-tab-chip"/>
                        <Button fx:id="cancelledTabBtn" text="Cancelled (0)" onAction="#handleShowCancelled" minWidth="-Infinity" styleClass="mb-tab-chip"/>
                    </HBox>
                </HBox>

                <!-- Content Area: Switch between Populated (2-col), Empty, and Error states -->
                <StackPane fx:id="contentStack" VBox.vgrow="ALWAYS">

                    <!-- 1. POPULATED STATE: Left booking list + Search bar | Right live white pass preview -->
                    <HBox fx:id="populatedSplitBox" spacing="18" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">

                        <!-- LEFT COLUMN: Booking list + Search flights bar -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="mb-list-panel" VBox.vgrow="ALWAYS">
                            <ScrollPane fx:id="bookingsScrollPane"
                                        styleClass="confirmation-scroll-pane"
                                        fitToWidth="true"
                                        fitToHeight="false"
                                        hbarPolicy="NEVER"
                                        vbarPolicy="AS_NEEDED"
                                        VBox.vgrow="ALWAYS">
                                <VBox fx:id="cardsContainer" spacing="10" alignment="TOP_CENTER" VBox.vgrow="ALWAYS"
                                      style="-fx-padding: 2 6 6 2; -fx-background-color: transparent;">
                                    <!-- Populated dynamically with selectable booking rows -->
                                </VBox>
                            </ScrollPane>

                            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="mb-search-bar">
                                <Label text="Need another trip?" styleClass="mb-search-prompt"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="bottomSearchFlightsBtn" text="Search flights →" onAction="#handleSearchFlights"
                                        minWidth="-Infinity" styleClass="btn-checkout-gold, mb-search-cta"/>
                            </HBox>
                        </VBox>

                        <!-- RIGHT COLUMN: Live White Boarding Pass Preview -->
                        <VBox fx:id="passPreviewCard" prefWidth="420" minWidth="360" maxWidth="440" spacing="12" styleClass="mb-pass-card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Sky Royal" styleClass="mb-pass-brand"/>
                                <Label text="BOARDING PASS" styleClass="mb-pass-tag"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="previewStatusBadge" text="UPCOMING" styleClass="mb-pass-status"/>
                            </HBox>

                            <Label fx:id="previewPnrLabel" text="PNR —" styleClass="mb-pass-pnr"/>

                            <!-- Cream Route Box -->
                            <VBox spacing="4" styleClass="mb-pass-route-box">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label fx:id="previewRouteCodeLabel" text="JNB → CPT" styleClass="mb-pass-route-code"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="previewFlightNoLabel" text="SR 204" styleClass="mb-pass-flight-pill"/>
                                </HBox>
                                <Label fx:id="previewRouteCitiesLabel" text="Johannesburg to Cape Town" styleClass="mb-pass-route-cities"/>
                                <Label fx:id="previewDateTimeLabel" text="" styleClass="mb-pass-route-time"/>
                            </VBox>

                            <!-- Metadata 2x2 Grid -->
                            <GridPane hgap="16" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="55"/>
                                    <ColumnConstraints percentWidth="45"/>
                                </columnConstraints>
                                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="PASSENGER" styleClass="ticket-grid-label"/>
                                    <Label fx:id="previewPassengerLabel" text="—" styleClass="ticket-grid-value"/>
                                </VBox>
                                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="SEAT" styleClass="ticket-grid-label"/>
                                    <Label fx:id="previewSeatLabel" text="—" styleClass="ticket-grid-value"/>
                                </VBox>
                                <VBox spacing="2" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="AIRCRAFT" styleClass="ticket-grid-label"/>
                                    <Label fx:id="previewAircraftLabel" text="—" styleClass="ticket-grid-value"/>
                                </VBox>
                                <VBox spacing="2" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="PAID FARE" styleClass="ticket-grid-label"/>
                                    <Label fx:id="previewFareLabel" text="R 0.00" styleClass="ticket-grid-value"/>
                                </VBox>
                            </GridPane>

                            <Region styleClass="mb-pass-divider"/>

                            <!-- Bottom Row: Real QR + Stacked Actions -->
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <VBox alignment="CENTER" spacing="4" styleClass="mb-qr-frame">
                                    <ImageView fx:id="previewQrImageView" fitWidth="104" fitHeight="104" preserveRatio="true"/>
                                    <Label text="Verify at gate" styleClass="mb-qr-caption"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Button fx:id="previewDownloadPdfBtn" text="Download PDF" onAction="#handlePreviewDownloadPdf"
                                            maxWidth="Infinity" styleClass="mb-btn-dark"/>
                                    <Button fx:id="previewAddCalendarBtn" text="Add to calendar" onAction="#handlePreviewAddCalendar"
                                            maxWidth="Infinity" styleClass="mb-btn-outline"/>
                                    <Button fx:id="previewViewPassBtn" text="View pass" onAction="#handlePreviewViewPass"
                                            maxWidth="Infinity" styleClass="mb-btn-outline"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- 2. EMPTY STATE -->
                    <VBox fx:id="emptyStateContainer" alignment="CENTER" spacing="16" visible="false" managed="false"
                          style="-fx-padding: 60 20 60 20;" VBox.vgrow="ALWAYS">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56"
                                   style="-fx-background-color: rgba(241, 238, 223, 0.15); -fx-background-radius: 999px; -fx-border-color: rgba(241, 238, 223, 0.40); -fx-border-radius: 999px;">
                            <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" style="-fx-stroke: -glass-cream; -fx-stroke-width: 2.2; -fx-fill: transparent;"/>
                        </StackPane>
                        <Label fx:id="emptyTitleLabel" text="No trips yet" styleClass="headline-serif" style="-fx-font-size: 24px;"/>
                        <Label fx:id="emptySubtitleLabel" text="When you book a flight, your tickets and trip details will appear here." styleClass="subheadline"/>
                        <Button fx:id="searchFlightsButton" text="Search flights" styleClass="btn-gold" onAction="#handleSearchFlights" prefWidth="200"/>
                    </VBox>

                    <!-- 3. ERROR STATE -->
                    <VBox fx:id="errorStateContainer" alignment="CENTER" spacing="16" visible="false" managed="false"
                          style="-fx-padding: 60 20 60 20;" VBox.vgrow="ALWAYS">
                        <StackPane prefWidth="56" prefHeight="56" maxWidth="56" maxHeight="56"
                                   style="-fx-background-color: rgba(239, 68, 68, 0.20); -fx-background-radius: 999px; -fx-border-color: rgba(239, 68, 68, 0.50); -fx-border-radius: 999px;">
                            <Label text="!" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #ef4444;"/>
                        </StackPane>
                        <Label fx:id="errorTitleLabel" text="Unable to load bookings" styleClass="headline-serif" style="-fx-font-size: 24px;"/>
                        <Label fx:id="errorMessageLabel" text="We encountered an issue retrieving your booking history. Please try again." styleClass="subheadline"/>
                        <Button fx:id="retryButton" text="Retry" styleClass="btn-gold" onAction="#handleRetry" prefWidth="180"/>
                    </VBox>

                    <!-- 4. GUEST (UNAUTHENTICATED) STATE -->
                    <VBox fx:id="guestStateContainer" alignment="CENTER" spacing="14" visible="false" managed="false"
                          style="-fx-padding: 48 20 48 20;" VBox.vgrow="ALWAYS">
                        <StackPane prefWidth="52" prefHeight="52" maxWidth="52" maxHeight="52"
                                   style="-fx-background-color: rgba(241, 238, 223, 0.14); -fx-background-radius: 999px; -fx-border-color: rgba(241, 238, 223, 0.36); -fx-border-radius: 999px;">
                            <SVGPath content="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"
                                     style="-fx-fill: -glass-cream;" scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                        <Label fx:id="guestTitleLabel" text="Sign in to see your bookings" styleClass="headline-serif" style="-fx-font-size: 22px;"/>
                        <Label fx:id="guestSubtitleLabel" text="Sign in to view your upcoming trips, boarding passes, and booking history." styleClass="subheadline" wrapText="true"/>
                        <Button fx:id="guestSignInButton" text="Sign in" styleClass="btn-gold" onAction="#handleGuestSignIn" prefWidth="180"/>
                    </VBox>

                </StackPane>

            </VBox>
        </StackPane>
    </VBox>

</GlassBackground>
