<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.component.GlassTopBar?>
<?import com.group2.flightres.component.StepperBar?>
<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import com.group2.flightres.util.GlassPlaneGraphic?>
<?import com.group2.flightres.util.GlassSeatMapBridge?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.SeatMapController"
                 photoPath="/com/group2/flightres/photos/karsten-winegeart-TkKTqPPkWP4-unsplash.jpg"
                 blurRadius="8.0"
                 darkness="0.0"
                 saturation="0.0"
                 enableSecondaryGlow="false"
                 stylesheets="@../css/glass.css"
                 styleClass="seat-map-glass-root"
                 prefWidth="1280"
                 prefHeight="800"
                 minWidth="1280"
                 minHeight="800"
                 maxWidth="1280"
                 maxHeight="800">

    <VBox alignment="TOP_CENTER" spacing="0" prefWidth="1280" prefHeight="800" minWidth="1280" minHeight="800" maxWidth="1280" maxHeight="800">

        <!-- ===================================================================
             TOP NAV (64 high, web-parity GlassTopBar)
             =================================================================== -->
        <GlassTopBar fx:id="topBar" activeNav="flights"/>

        <!-- ===================================================================
             MAIN GLASS CARD
             =================================================================== -->
        <VBox VBox.vgrow="ALWAYS" spacing="12" styleClass="search-main-glass"
              maxWidth="1168">
            <VBox.margin>
                <Insets top="4" right="40" bottom="20" left="40"/>
            </VBox.margin>

            <!-- 1. Stepper Bar -->
            <HBox alignment="CENTER" prefHeight="48" minHeight="48" maxHeight="48" styleClass="glass-stepper-card">
                <StepperBar fx:id="stepperBar" alignment="CENTER" prefHeight="48"/>
            </HBox>

            <!-- 2. Main Workspace Split: Left Columns + Right Column (320w) -->
            <HBox VBox.vgrow="ALWAYS" spacing="14" minHeight="0">

                <!-- LEFT COLUMN: Plane Card + (Cabin Photo Card + Seat Grid) -->
                <VBox HBox.hgrow="ALWAYS" spacing="12" minHeight="0">

                    <!-- A. Plane Card -->
                    <VBox prefHeight="214" minHeight="214" maxHeight="214"
                          styleClass="glass-card, seat-plane-card">

                        <HBox alignment="TOP_LEFT" spacing="12">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Choose your seat" styleClass="seat-card-title" minWidth="-Infinity"/>
                                <Label fx:id="planeCardSubtitle" text="-" styleClass="seat-card-subtitle"/>
                            </VBox>

                            <HBox styleClass="section-tab-bar" spacing="4" minWidth="-Infinity">
                                <Button fx:id="section1Tab" text="Section 1" minWidth="-Infinity" styleClass="section-tab, section-tab-on" onAction="#handleSelectSection1"/>
                                <Button fx:id="section2Tab" text="Section 2" minWidth="-Infinity" styleClass="section-tab" onAction="#handleSelectSection2"/>
                                <Button fx:id="section3Tab" text="Section 3" minWidth="-Infinity" styleClass="section-tab" onAction="#handleSelectSection3"/>
                            </HBox>
                        </HBox>

                        <HBox spacing="6" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                            <VBox spacing="10" alignment="TOP_CENTER" styleClass="seat-zoom-col" minWidth="40" maxWidth="40">
                                <Button styleClass="plane-action-btn" onAction="#handleZoomGrid" accessibleText="Zoom">
                                    <graphic>
                                        <SVGPath content="M11 4.5 A 6.5 6.5 0 1 0 11 17.5 A 6.5 6.5 0 1 0 11 4.5 M16 16l5 5 M11 8v6 M8 11h6"
                                                 styleClass="seat-zoom-icon"/>
                                    </graphic>
                                </Button>
                            </VBox>

                            <StackPane alignment="CENTER" HBox.hgrow="ALWAYS" prefHeight="152" minHeight="152" maxHeight="152" minWidth="0">
                                <Group>
                                    <GlassPlaneGraphic fx:id="planeGraphic" scaleX="0.72" scaleY="0.72"/>
                                </Group>
                            </StackPane>
                        </HBox>
                    </VBox>

                    <!-- B. Bottom Row: Cabin Photo Card + Seat Grid Card -->
                    <HBox VBox.vgrow="ALWAYS" spacing="14" minHeight="0">

                        <!-- Inside the cabin photo card (dynamic per section, click to expand lightbox) -->
                        <StackPane fx:id="cabinPhotoCard" prefWidth="176" minWidth="172" maxWidth="180" styleClass="seat-cabin-photo-card">
                            <clip>
                                <Rectangle width="176" height="400" arcWidth="36" arcHeight="36"/>
                            </clip>
                            <ImageView fx:id="cabinPhotoView" fitWidth="176" fitHeight="400" preserveRatio="false">
                                <image>
                                    <Image url="@../photos/karsten-winegeart-TkKTqPPkWP4-unsplash.jpg"/>
                                </image>
                            </ImageView>
                            <Region styleClass="seat-cabin-photo-scrim"/>
                            <VBox alignment="BOTTOM_LEFT" spacing="6" styleClass="seat-cabin-photo-content">
                                <Label fx:id="cabinKickerLabel" text="SECTION 1 CABIN" styleClass="seat-cabin-kicker"/>
                                <Label fx:id="cabinTitleLabel" text="Inside the cabin" styleClass="seat-cabin-title"/>
                                <Label text="Economy 3-3 and First 2-2 seating. Select any available seat on the map."
                                       wrapText="true" prefWidth="136"
                                       styleClass="seat-cabin-desc"/>
                            </VBox>
                        </StackPane>

                        <!-- Seat Grid Card -->
                        <VBox HBox.hgrow="ALWAYS" styleClass="glass-card, seat-grid-card" spacing="8" minHeight="0">
                            <VBox spacing="6">
                                <Label fx:id="sectionHeaderLabel" text="-" styleClass="seat-section-header" minWidth="-Infinity"/>

                                <!-- Sky Royal Glass Legend: Available, First, Taken (x), Held by another, Yours -->
                                <HBox alignment="CENTER_LEFT" spacing="12" minWidth="-Infinity">
                                    <HBox alignment="CENTER" spacing="4" minWidth="-Infinity">
                                        <Region styleClass="seat-legend-swatch, seat-legend-available"/>
                                        <Label text="Available" minWidth="-Infinity" styleClass="seat-legend-label"/>
                                    </HBox>
                                    <HBox alignment="CENTER" spacing="4" minWidth="-Infinity">
                                        <Region styleClass="seat-legend-swatch, seat-legend-first"/>
                                        <Label text="First" minWidth="-Infinity" styleClass="seat-legend-label"/>
                                    </HBox>
                                    <HBox alignment="CENTER" spacing="4" minWidth="-Infinity">
                                        <StackPane styleClass="seat-legend-swatch, seat-legend-taken">
                                            <Label text="×" styleClass="seat-legend-taken-x"/>
                                        </StackPane>
                                        <Label text="Taken" minWidth="-Infinity" styleClass="seat-legend-label"/>
                                    </HBox>
                                    <HBox alignment="CENTER" spacing="4" minWidth="-Infinity">
                                        <Region styleClass="seat-legend-swatch, seat-legend-held"/>
                                        <Label text="Held by another" minWidth="-Infinity" styleClass="seat-legend-label"/>
                                    </HBox>
                                    <HBox alignment="CENTER" spacing="4" minWidth="-Infinity">
                                        <Region styleClass="seat-legend-swatch, seat-legend-yours"/>
                                        <Label text="Yours" minWidth="-Infinity" styleClass="seat-legend-label"/>
                                    </HBox>
                                </HBox>
                            </VBox>

                            <VBox fx:id="zoomContainer" alignment="CENTER" spacing="7" VBox.vgrow="ALWAYS">
                                <HBox fx:id="seatGridNumbersRow" spacing="8" alignment="CENTER"/>
                                <VBox fx:id="seatGridRowsContainer" spacing="6" alignment="CENTER"/>
                            </VBox>
                        </VBox>

                    </HBox>
                </VBox>

                <!-- RIGHT COLUMN (width 306): Cream Selection Card + Flight Card -->
                <VBox prefWidth="306" minWidth="296" maxWidth="310" spacing="10">

                    <!-- A. Selection Card (with Cream highlight header matching board-3) -->
                    <VBox styleClass="glass-card, seat-right-card" spacing="10">
                        <!-- Cream highlight card for selected seat -->
                        <VBox styleClass="seat-selection-cream-box" spacing="8">
                            <Label text="YOUR SEAT" styleClass="seat-cream-kicker"/>

                            <HBox alignment="BOTTOM_LEFT">
                                <Label fx:id="bigSeatLabel" text="—" styleClass="seat-cream-big-seat"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <VBox alignment="BOTTOM_RIGHT" spacing="2">
                                    <Label text="Seat fare" styleClass="seat-cream-fare-sub"/>
                                    <Label fx:id="bigPriceLabel" text="R 0" styleClass="seat-cream-fare-val"/>
                                </VBox>
                            </HBox>

                            <HBox fx:id="chipsContainer" spacing="6"/>
                        </VBox>

                        <!-- Price Breakdown Rows -->
                        <VBox spacing="3" styleClass="seat-breakdown-box">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Base fare" styleClass="seat-break-lbl"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatBaseFareLabel" text="-" styleClass="seat-break-val"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="seatCabinTitleLabel" text="Cabin" styleClass="seat-break-lbl"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatCabinLabel" text="-" styleClass="seat-break-val"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Demand" styleClass="seat-break-lbl"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatDemandLabel" text="-" styleClass="seat-break-val"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Booking time" styleClass="seat-break-lbl"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatTimingLabel" text="-" styleClass="seat-break-val"/>
                            </HBox>
                            <Region styleClass="seat-divider"/>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Total" styleClass="seat-total-lbl"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatTotalLabel" text="-" styleClass="seat-total-val"/>
                            </HBox>
                            <Label fx:id="seatVatLabel" text="" styleClass="seat-vat-lbl"/>
                        </VBox>

                        <!-- Hold Countdown Timer Row -->
                        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="seat-timer-row">
                            <StackPane prefWidth="42" prefHeight="42" minWidth="42" minHeight="42" maxWidth="42" maxHeight="42">
                                <Circle radius="17" fill="transparent" stroke="rgba(255,255,255,0.14)" strokeWidth="4"/>
                                <Arc fx:id="timerArc" radiusX="17" radiusY="17" startAngle="90" length="0" type="OPEN"
                                     fill="transparent" stroke="#4da3ff" strokeWidth="4" strokeLineCap="ROUND"/>
                            </StackPane>
                            <VBox spacing="1" HBox.hgrow="ALWAYS">
                                <Label fx:id="timerLabel" text="--:--" styleClass="seat-timer-val"/>
                                <Label text="Held for you. Nobody else can take it." wrapText="true" prefWidth="172" minHeight="-Infinity" maxWidth="172" styleClass="seat-timer-sub"/>
                            </VBox>
                        </HBox>

                        <!-- Action Buttons -->
                        <Button fx:id="continueButton"
                                text="Continue to checkout"
                                onAction="#handleContinue"
                                prefHeight="46" minHeight="46" maxHeight="46"
                                maxWidth="Infinity"
                                styleClass="btn-checkout-gold">
                            <graphic>
                                <SVGPath content="M9 6l6 6-6 6" styleClass="seat-continue-arrow"/>
                            </graphic>
                        </Button>

                        <Button fx:id="releaseButton"
                                text="Release seat and choose another"
                                onAction="#handleReleaseSeat"
                                prefHeight="38" minHeight="38" maxHeight="38"
                                maxWidth="Infinity"
                                styleClass="btn-release-ghost"/>
                    </VBox>

                    <!-- B. Flight Card -->
                    <VBox styleClass="glass-card, seat-flight-card" spacing="8" VBox.vgrow="ALWAYS">
                        <Label text="FLIGHT" styleClass="seat-flight-kicker"/>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <VBox>
                                <Label fx:id="flightOriginCode" text="-" styleClass="seat-flight-code"/>
                                <Label fx:id="flightOriginTime" text="-" styleClass="seat-flight-time"/>
                            </VBox>

                            <HBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="5">
                                <Region styleClass="seat-route-dot"/>
                                <Region HBox.hgrow="ALWAYS" styleClass="seat-route-dash"/>
                                <SVGPath content="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"
                                         styleClass="seat-route-plane"/>
                            </HBox>

                            <VBox alignment="CENTER_RIGHT">
                                <Label fx:id="flightDestCode" text="-" styleClass="seat-flight-code"/>
                                <Label fx:id="flightDestTime" text="-" styleClass="seat-flight-time"/>
                            </VBox>
                        </HBox>

                        <Region styleClass="seat-divider"/>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Flight" styleClass="seat-break-lbl" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="flightNoLabel" text="-" styleClass="seat-break-val"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Aircraft" styleClass="seat-break-lbl" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="flightAircraftLabel" text="-" styleClass="seat-break-val"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Duration" styleClass="seat-break-lbl" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="flightDurationLabel" text="-" styleClass="seat-break-val"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Free seats" styleClass="seat-break-lbl" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="freeSeatsLabel" text="-" styleClass="seat-free-seats-val"/>
                        </HBox>
                    </VBox>

                </VBox>
            </HBox>

            <!-- Hidden Compatibility Controls & Bridge -->
            <VBox visible="false" managed="false">
                <VBox fx:id="cabinContainer" visible="false" managed="false"/>
                <Label fx:id="flightTitleLabel" visible="false" managed="false"/>
                <Label fx:id="seatSelectionLabel" visible="false" managed="false"/>
                <Label fx:id="baseFareLabel" visible="false" managed="false"/>
                <Label fx:id="classMultiplierLabel" visible="false" managed="false"/>
                <Label fx:id="demandPricingLabel" visible="false" managed="false"/>
                <Label fx:id="totalPriceLabel" visible="false" managed="false"/>
                <Button fx:id="backButton" onAction="#handleBack" visible="false" managed="false"/>
                <Label fx:id="fallbackNoticeLabel" visible="false" managed="false"/>
                <GlassSeatMapBridge fx:id="glassBridge" visible="false" managed="false"/>
            </VBox>
        </VBox>
    </VBox>

</GlassBackground>
