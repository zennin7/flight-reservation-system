<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.component.StepperBar?>
<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import com.group2.flightres.util.GlassPlaneGraphic?>
<?import com.group2.flightres.util.GlassSeatMapBridge?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.SeatMapController"
                 photoPath="/images/destinations/dur.jpg"
                 blurRadius="26.0"
                 darkness="-0.50"
                 saturation="0.20"
                 linearOverlay="linear-gradient(to bottom, rgba(11,18,32,0.40) 0%, rgba(11,18,32,0.72) 100%)"
                 radialGlow="radial-gradient(center 80% 0%, radius 50%, rgba(212,166,60,0.16) 0%, transparent 100%)"
                 enableSecondaryGlow="false"
                 stylesheets="@../css/glass.css"
                 styleClass="seat-map-glass-root"
                 prefWidth="1280"
                 prefHeight="860"
                 minWidth="1280"
                 minHeight="860"
                 maxWidth="1280"
                 maxHeight="860">

    <VBox alignment="TOP_CENTER" spacing="0" prefWidth="1280" prefHeight="860" minWidth="1280" minHeight="860" maxWidth="1280" maxHeight="860">

        <!-- ===================================================================
             TOP NAV (64 high, padding 0 56)
             =================================================================== -->
        <HBox alignment="CENTER_LEFT" prefHeight="64" minHeight="64" maxHeight="64" styleClass="glass-nav-bar">
            <!-- Brand row: gold plane icon + APP_NAME -->
            <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleNavHome" style="-fx-cursor: hand;">
                <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" styleClass="nav-brand-plane"/>
                <Label styleClass="nav-brand-text">
                    <text><BrandConfig fx:constant="APP_NAME"/></text>
                </Label>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Center nav links: Flights (active pill), My Bookings, Offers, About, Contact -->
            <HBox alignment="CENTER" spacing="30" styleClass="glass-nav-links-box">
                <Button text="Flights" styleClass="glass-nav-link, glass-nav-link-active" onAction="#handleNavFlights"/>
                <Button text="My Bookings" styleClass="glass-nav-link" onAction="#handleNavBookings"/>
                <Button text="Offers" styleClass="glass-nav-link" onAction="#handleNavOffers"/>
                <Button text="About" styleClass="glass-nav-link" onAction="#handleNavAbout"/>
                <Button text="Contact" styleClass="glass-nav-link" onAction="#handleNavContact"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Right avatar circle: 34px diameter, #d4a63c with initials AM -->
            <StackPane styleClass="glass-avatar-circle" onMouseClicked="#handleNavAvatar" style="-fx-cursor: hand;">
                <Label text="AM" styleClass="glass-avatar-initials"/>
            </StackPane>
        </HBox>

        <!-- ===================================================================
             MAIN GLASS CARD (Margins: left/right 56, top 4, bottom 32)
             =================================================================== -->
        <VBox VBox.vgrow="ALWAYS" spacing="14" styleClass="search-main-glass"
              prefWidth="1168" minWidth="1168" maxWidth="1168">
            <VBox.margin>
                <Insets top="4" right="56" bottom="32" left="56"/>
            </VBox.margin>

            <!-- 1. Stepper Bar (height 52, inner card) -->
            <HBox alignment="CENTER" prefHeight="52" minHeight="52" maxHeight="52" styleClass="glass-stepper-card">
                <StepperBar fx:id="stepperBar" alignment="CENTER" prefHeight="52"/>
            </HBox>

            <!-- 2. Main Workspace Split: Left Columns (796w) + Right Column (330w) -->
            <HBox VBox.vgrow="ALWAYS" spacing="14" minHeight="0" prefWidth="1140" minWidth="1140" maxWidth="1140">

                <!-- =======================================================
                     LEFT COLUMN: Plane Card + (Info Card + Seat Grid)
                     ======================================================= -->
                <VBox prefWidth="796" minWidth="796" maxWidth="796" spacing="14" minHeight="0">

                    <!-- A. Plane Card (height 236, inner card, clipped) -->
                    <VBox prefHeight="236" minHeight="236" maxHeight="236" prefWidth="796" minWidth="796" maxWidth="796"
                          styleClass="glass-card" style="-fx-padding: 16px 22px 0 22px;">
                        <clip>
                            <Rectangle width="796" height="236" arcWidth="40" arcHeight="40"/>
                        </clip>

                        <!-- Top Header Row: Title & Subtitle + Section Tabs -->
                        <HBox alignment="TOP_LEFT" prefWidth="752" minWidth="752" maxWidth="752">
                            <VBox spacing="2">
                                <Label text="Choose your seat" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 19px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                <Label fx:id="planeCardSubtitle" text="-" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.60);"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- Section Tabs (Pill Box) -->
                            <HBox styleClass="section-tab-bar">
                                <Button fx:id="section1Tab" text="Section 1" styleClass="section-tab, section-tab-on" onAction="#handleSelectSection1"/>
                                <Button fx:id="section2Tab" text="Section 2" styleClass="section-tab" onAction="#handleSelectSection2"/>
                                <Button fx:id="section3Tab" text="Section 3" styleClass="section-tab" onAction="#handleSelectSection3"/>
                            </HBox>
                        </HBox>

                        <!-- Content Row: Action Buttons (left) + Scaled Aircraft Vector Graphic -->
                        <HBox spacing="6" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT" prefWidth="752" minWidth="752" maxWidth="752" style="-fx-padding: 0;">
                            <!-- Action Buttons: Zoom (+) -->
                            <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 14px 0 0 0;" minWidth="44" maxWidth="44">

                                <Button styleClass="plane-action-btn" onAction="#handleZoomGrid" accessibleText="Zoom">
                                    <graphic>
                                        <SVGPath content="M11 4.5 A 6.5 6.5 0 1 0 11 17.5 A 6.5 6.5 0 1 0 11 4.5 M16 16l5 5 M11 8v6 M8 11h6"
                                                 style="-fx-fill: transparent; -fx-stroke: #ffffff; -fx-stroke-width: 1.8; -fx-stroke-line-cap: round; -fx-scale-x: 0.75; -fx-scale-y: 0.75;"/>
                                    </graphic>
                                </Button>
                            </VBox>

                            <!-- Side-View Aircraft Vector Graphic Scaled to Fit Inside 700px -->
                            <StackPane alignment="CENTER" prefWidth="700" minWidth="700" maxWidth="700" prefHeight="170" minHeight="170" maxHeight="170">
                                <GlassPlaneGraphic fx:id="planeGraphic" scaleX="0.77" scaleY="0.77" translateX="-36"/>
                            </StackPane>
                        </HBox>
                    </VBox>

                    <!-- B. Bottom Row: Info Card (206w) + Seat Grid Card (576w) = 796w -->
                    <HBox VBox.vgrow="ALWAYS" spacing="14" minHeight="0" prefWidth="796" minWidth="796" maxWidth="796">

                        <!-- Info Card (width 206) -->
                        <VBox prefWidth="206" minWidth="206" maxWidth="206" styleClass="cabin-view-card">
                            <HBox alignment="TOP_LEFT">
                                <StackPane styleClass="cabin-icon-tile">
                                    <SVGPath content="M12 3l8 4.5v9L12 21l-8-4.5v-9z M12 12l8-4.5 M12 12v9 M12 12L4 7.5"
                                             style="-fx-fill: transparent; -fx-stroke: #0b1220; -fx-stroke-width: 2.0; -fx-stroke-line-cap: round; -fx-stroke-line-join: round; -fx-scale-x: 0.9; -fx-scale-y: 0.9;"/>
                                </StackPane>
                                <Region HBox.hgrow="ALWAYS"/>
                                <SVGPath content="M7 17L17 7M9 7h8v8"
                                         style="-fx-fill: transparent; -fx-stroke: rgba(255,255,255,0.70); -fx-stroke-width: 2.0; -fx-stroke-line-cap: round; -fx-stroke-line-join: round; -fx-scale-x: 0.7; -fx-scale-y: 0.7;"/>
                            </HBox>

                            <Region VBox.vgrow="ALWAYS"/>

                            <VBox spacing="6">
                                <Label text="Select your seat" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 17px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                <Label text="Choose your preferred seat on the map. Legroom and seat amenities vary by cabin class."
                                       wrapText="true" prefWidth="168"
                                       style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.60); -fx-line-spacing: 2px;"/>
                            </VBox>
                        </VBox>

                        <!-- Seat Grid Card (width 576) -->
                        <VBox prefWidth="576" minWidth="576" maxWidth="576" styleClass="glass-card" style="-fx-padding: 16px 18px;" spacing="10" minHeight="0">
                            <!-- Section Title & Legend Row -->
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label fx:id="sectionHeaderLabel" text="-"
                                       style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>

                                <Region HBox.hgrow="ALWAYS"/>

                                <!-- Legend: Free (green), Taken (red), Yours (gold) -->
                                <HBox alignment="CENTER" spacing="10">
                                    <HBox alignment="CENTER" spacing="5">
                                        <Region style="-fx-min-width: 10px; -fx-min-height: 10px; -fx-max-width: 10px; -fx-max-height: 10px; -fx-background-radius: 3px; -fx-background-color: rgba(34,197,94,0.35); -fx-border-color: rgba(74,222,128,0.70); -fx-border-radius: 3px; -fx-border-width: 1px;"/>
                                        <Label text="Free" style="-fx-font-family: 'Inter'; -fx-font-size: 11.5px; -fx-text-fill: rgba(255,255,255,0.60);"/>
                                    </HBox>
                                    <HBox alignment="CENTER" spacing="5">
                                        <Region style="-fx-min-width: 10px; -fx-min-height: 10px; -fx-max-width: 10px; -fx-max-height: 10px; -fx-background-radius: 3px; -fx-background-color: rgba(220,38,38,0.30); -fx-border-color: rgba(248,113,113,0.50); -fx-border-radius: 3px; -fx-border-width: 1px;"/>
                                        <Label text="Taken" style="-fx-font-family: 'Inter'; -fx-font-size: 11.5px; -fx-text-fill: rgba(255,255,255,0.60);"/>
                                    </HBox>
                                    <HBox alignment="CENTER" spacing="5">
                                        <Region style="-fx-min-width: 10px; -fx-min-height: 10px; -fx-max-width: 10px; -fx-max-height: 10px; -fx-background-radius: 3px; -fx-background-color: #d4a63c;"/>
                                        <Label text="Yours" style="-fx-font-family: 'Inter'; -fx-font-size: 11.5px; -fx-text-fill: rgba(255,255,255,0.60);"/>
                                    </HBox>
                                </HBox>
                            </HBox>

                            <!-- Rotated Grid Container (Zoomable, Centered) -->
                            <VBox fx:id="zoomContainer" alignment="CENTER" spacing="7" VBox.vgrow="ALWAYS">
                                <!-- Column numbers row across top -->
                                <HBox fx:id="seatGridNumbersRow" spacing="8" alignment="CENTER"/>
                                <!-- Seat rows container (Letters down left: A, B, C, aisle gap, D, E, F) -->
                                <VBox fx:id="seatGridRowsContainer" spacing="6" alignment="CENTER"/>
                            </VBox>
                        </VBox>

                    </HBox>
                </VBox>

                <!-- =======================================================
                     RIGHT COLUMN (width 330): Selection Card + Flight Card
                     ======================================================= -->
                <VBox prefWidth="330" minWidth="330" maxWidth="330" spacing="14">

                    <!-- A. Selection Card -->
                    <VBox styleClass="glass-card" style="-fx-padding: 20px 22px; -fx-background-color: linear-gradient(to bottom right, rgba(212,166,60,0.22), rgba(8,12,22,0.40) 60%);" spacing="10">
                        <Label text="YOUR SELECTION" styleClass="sec" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #e8c46a; -fx-letter-spacing: 0.14em;"/>

                        <!-- Seat Number & Price Row -->
                        <HBox alignment="BOTTOM_LEFT">
                            <Label fx:id="bigSeatLabel" text="�" style="-fx-font-family: 'Inter Bold', 'Inter'; -fx-font-size: 72px; -fx-font-weight: 700; -fx-text-fill: #f3d98b; -fx-line-spacing: 0; -fx-padding: 0;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <VBox alignment="BOTTOM_RIGHT" style="-fx-padding: 0 0 8px 0;">
                                <Label text="Seat fare, before taxes and fees" style="-fx-font-family: 'Inter'; -fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.60); -fx-alignment: CENTER_RIGHT;"/>
                                <Label fx:id="bigPriceLabel" text="R 0" style="-fx-font-family: 'Inter Bold', 'Inter'; -fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #ffffff; -fx-alignment: CENTER_RIGHT;"/>
                            </VBox>
                        </HBox>

                        <!-- Chips Row -->
                        <HBox fx:id="chipsContainer" spacing="6" style="-fx-padding: 4px 0 0 0;"/>

                        <!-- Price Breakdown Rows: Base fare / Cabin / Demand / Booking time / Total / Includes VAT -->
                        <VBox spacing="3" style="-fx-padding: 6px 0 2px 0;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Base fare" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.70);"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatBaseFareLabel" text="-" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="seatCabinTitleLabel" text="Cabin" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.70);"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatCabinLabel" text="-" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Demand" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.70);"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatDemandLabel" text="-" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Booking time" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.70);"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatTimingLabel" text="-" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 12px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                            </HBox>
                            <Region style="-fx-min-height: 1px; -fx-pref-height: 1px; -fx-max-height: 1px; -fx-background-color: rgba(255,255,255,0.12); -fx-margin: 3px 0;"/>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Total" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="seatTotalLabel" text="-" style="-fx-font-family: 'Inter Bold'; -fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: #f3d98b;"/>
                            </HBox>
                            <Label fx:id="seatVatLabel" text="" style="-fx-font-family: 'Inter'; -fx-font-size: 10.5px; -fx-text-fill: rgba(255,255,255,0.50); -fx-alignment: CENTER_RIGHT;"/>
                        </VBox>

                        <!-- Hold Countdown Timer Row -->
                        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10px 12px; -fx-background-color: rgba(0,0,0,0.25); -fx-background-radius: 14px; -fx-margin: 6px 0 0 0;">
                            <StackPane prefWidth="44" prefHeight="44" minWidth="44" minHeight="44" maxWidth="44" maxHeight="44">
                                <Circle radius="18" fill="transparent" stroke="rgba(255,255,255,0.14)" strokeWidth="4"/>
                                <Arc fx:id="timerArc" radiusX="18" radiusY="18" startAngle="90" length="0" type="OPEN"
                                     fill="transparent" stroke="#e8c46a" strokeWidth="4" strokeLineCap="ROUND"/>
                            </StackPane>
                            <VBox spacing="1" HBox.hgrow="ALWAYS">
                                <Label fx:id="timerLabel" text="--:--" style="-fx-font-family: 'Inter Bold', 'Inter'; -fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #ffffff;"/>
                                <Label text="Held for you. Nobody else can take it." wrapText="true" prefWidth="204" maxWidth="240" style="-fx-font-family: 'Inter'; -fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.60);"/>
                            </VBox>
                        </HBox>

                        <!-- Action Buttons -->
                        <Button fx:id="continueButton"
                                text="Continue to checkout"
                                onAction="#handleContinue"
                                prefHeight="54" minHeight="54" maxHeight="54"
                                maxWidth="Infinity"
                                styleClass="btn-checkout-gold"
                                style="-fx-margin: 6px 0 0 0;">
                            <graphic>
                                <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <SVGPath content="M9 6l6 6-6 6"
                                             style="-fx-fill: transparent; -fx-stroke: #0b1220; -fx-stroke-width: 2.6; -fx-stroke-line-cap: round; -fx-stroke-line-join: round; -fx-scale-x: 0.8; -fx-scale-y: 0.8;"/>
                                </HBox>
                            </graphic>
                        </Button>

                        <Button fx:id="releaseButton"
                                text="Release seat and choose another"
                                onAction="#handleReleaseSeat"
                                prefHeight="44" minHeight="44" maxHeight="44"
                                maxWidth="Infinity"
                                styleClass="btn-release-ghost"/>
                    </VBox>

                    <!-- B. Flight Card -->
                    <VBox styleClass="glass-card" style="-fx-padding: 18px 22px;" spacing="10" VBox.vgrow="ALWAYS">
                        <Label text="FLIGHT" styleClass="sec" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: #e8c46a; -fx-letter-spacing: 0.14em;"/>

                        <!-- Route Row -->
                        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 4px 0 0 0;">
                            <VBox>
                                <Label fx:id="flightOriginCode" text="-" style="-fx-font-family: 'Inter Bold', 'Inter'; -fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #ffffff; -fx-line-spacing: 0;"/>
                                <Label fx:id="flightOriginTime" text="-" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.60); -fx-padding: 4px 0 0 0;"/>
                            </VBox>

                            <!-- Route Connector: Dot -> Dashed Line -> Plane Icon -->
                            <HBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="6">
                                <Region style="-fx-min-width: 7px; -fx-min-height: 7px; -fx-max-width: 7px; -fx-max-height: 7px; -fx-background-color: #e8c46a; -fx-background-radius: 4px;"/>
                                <Region HBox.hgrow="ALWAYS" style="-fx-border-color: rgba(255,255,255,0.35); -fx-border-style: dashed; -fx-border-width: 1.5px 0 0 0; -fx-min-height: 2px;"/>
                                <SVGPath content="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"
                                         style="-fx-fill: #e8c46a; -fx-scale-x: 0.7; -fx-scale-y: 0.7; -fx-rotate: 90;"/>
                            </HBox>

                            <VBox alignment="CENTER_RIGHT">
                                <Label fx:id="flightDestCode" text="-" style="-fx-font-family: 'Inter Bold', 'Inter'; -fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #ffffff; -fx-line-spacing: 0; -fx-alignment: CENTER_RIGHT;"/>
                                <Label fx:id="flightDestTime" text="-" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.60); -fx-padding: 4px 0 0 0; -fx-alignment: CENTER_RIGHT;"/>
                            </VBox>
                        </HBox>

                        <Region style="-fx-min-height: 1px; -fx-pref-height: 1px; -fx-max-height: 1px; -fx-background-color: rgba(255,255,255,0.10); -fx-margin: 6px 0;"/>

                        <!-- Details Rows -->
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Flight" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.60);" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="flightNoLabel" text="-" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Aircraft" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.60);" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="flightAircraftLabel" text="-" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Duration" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.60);" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="flightDurationLabel" text="-" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Free seats" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.60);" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label fx:id="freeSeatsLabel" text="-" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #4ade80;"/>
                        </HBox>
                    </VBox>

                </VBox>
            </HBox>

            <!-- ===================================================================
                 Hidden Compatibility Controls & Bridge (Preserves all original fx:ids)
                 =================================================================== -->
            <VBox visible="false" managed="false">
                <VBox fx:id="cabinContainer" visible="false" managed="false"/>
                <Label fx:id="flightTitleLabel" visible="false" managed="false"/>
                <Label fx:id="seatSelectionLabel" visible="false" managed="false"/>
                <Label fx:id="baseFareLabel" visible="false" managed="false"/>
                <Label fx:id="classMultiplierLabel" visible="false" managed="false"/>
                <Label fx:id="demandPricingLabel" visible="false" managed="false"/>
                <Label fx:id="totalPriceLabel" visible="false" managed="false"/>
                <Button fx:id="backButton" onAction="#handleBack" visible="false" managed="false"/>
                <Label fx:id="fallbackNoticeLabel" visible="false" managed="false"/>
                <GlassSeatMapBridge fx:id="glassBridge" visible="false" managed="false"/>
            </VBox>
        </VBox>
    </VBox>

</GlassBackground>
