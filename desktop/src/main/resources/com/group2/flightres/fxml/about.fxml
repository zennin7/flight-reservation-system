<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.group2.flightres.controller.AboutController"
           alignment="CENTER"
           styleClass="shell-root"
           prefWidth="1000"
           prefHeight="676">

    <VBox alignment="TOP_CENTER" spacing="16" maxWidth="560" maxHeight="-Infinity" styleClass="card">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32"/>
        </padding>

        <!-- Brand Title -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="Sky" styleClass="logo-text-sky"/>
            <Label text="Voyage" styleClass="logo-text-voyage"/>
        </HBox>

        <Label fx:id="aboutTitleLabel" text="About Altitude" styleClass="confirmation-title"/>
        <Label text="A modern flight reservation and booking management system designed for seamless travel experiences."
               styleClass="confirmation-subtitle"
               textAlignment="CENTER"
               wrapText="true"/>

        <!-- Divider -->
        <Region styleClass="checkout-divider" maxWidth="Infinity">
            <VBox.margin>
                <Insets top="4" bottom="4"/>
            </VBox.margin>
        </Region>

        <!-- Project Details Rows -->
        <VBox spacing="10" maxWidth="Infinity">
            <HBox alignment="CENTER_LEFT" styleClass="checkout-row">
                <Label text="Engineering Team" styleClass="checkout-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label text="Group 2" styleClass="checkout-val-medium"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="checkout-row">
                <Label text="Project" styleClass="checkout-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label fx:id="projectNameLabel" text="Altitude Flight Reservation System" styleClass="checkout-val-medium"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="checkout-row">
                <Label text="Technologies" styleClass="checkout-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label text="JavaFX 21 · PostgreSQL · Maven · OpenPDF" styleClass="checkout-val-medium"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="checkout-row">
                <Label text="Theme &amp; UI" styleClass="checkout-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label text="Dynamic Dual Theme (Light &amp; Dark)" styleClass="checkout-val-medium"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" styleClass="checkout-row">
                <Label text="Version" styleClass="checkout-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label text="1.0.0 (Release)" styleClass="checkout-val-medium"/>
            </HBox>
        </VBox>

        <!-- Back Button -->
        <HBox alignment="CENTER">
            <VBox.margin>
                <Insets top="12"/>
            </VBox.margin>
            <Button fx:id="backToHomeBtn"
                    text="Back to Home"
                    onAction="#handleBackToHome"
                    styleClass="btn-gold"
                    minWidth="180"/>
        </HBox>
    </VBox>

</StackPane>
