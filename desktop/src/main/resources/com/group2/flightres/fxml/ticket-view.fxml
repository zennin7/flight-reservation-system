<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<fx:root type="javafx.scene.layout.StackPane"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         stylesheets="@../css/glass.css"
         styleClass="ticket-view-root"
         alignment="CENTER">

    <!-- Fixed Design Container: exactly 780x575, scaled uniformly by TicketView -->
    <Group fx:id="scaleGroup">
        <StackPane fx:id="designContainer"
               prefWidth="780" minWidth="780" maxWidth="780"
               prefHeight="575" minHeight="575" maxHeight="575"
               alignment="CENTER">

        <!-- Outer Card HBox: Photo Panel + Ticket Body + Perforation + Stub -->
        <HBox fx:id="ticketCardBox"
              prefWidth="780" minWidth="780" maxWidth="780"
              prefHeight="575" minHeight="575" maxHeight="575"
              styleClass="ticket-card" alignment="CENTER_LEFT">

            <!-- 1. Left Destination Photo Panel (165x575, cover crop, clipped left corners) -->
            <StackPane fx:id="photoPanel"
                       prefWidth="165" minWidth="165" maxWidth="165"
                       prefHeight="575" minHeight="575" maxHeight="575"
                       styleClass="ticket-photo-panel">
                <ImageView fx:id="photoImageView" fitWidth="165" fitHeight="575" preserveRatio="false"/>
                <Region fx:id="photoGradientOverlay" styleClass="ticket-photo-gradient"
                        prefWidth="165" prefHeight="575"/>

                <VBox style="-fx-padding: 24 14 22 14;" alignment="TOP_LEFT">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" styleClass="ticket-brand-plane"/>
                        <Label text="Sky Royal" styleClass="ticket-brand-label"/>
                    </HBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <VBox spacing="3">
                        <Label text="WELCOME TO" styleClass="ticket-welcome-label"/>
                        <Label fx:id="welcomeCityLabel" text="" styleClass="ticket-welcome-city" wrapText="true" maxWidth="136"/>
                    </VBox>
                </VBox>
            </StackPane>

            <!-- 2. Center Ticket Body (424x575) -->
            <VBox fx:id="ticketBodyBox"
                  prefWidth="424" minWidth="424" maxWidth="424"
                  prefHeight="575" minHeight="575" maxHeight="575"
                  style="-fx-padding: 24 16 20 16;">

                <!-- Header: Overline + Cabin Badge -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="BOARDING PASS" styleClass="ticket-grid-label" style="-fx-letter-spacing: 0.16em;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="cabinBadgeLabel" text="Economy" styleClass="ticket-cabin-badge"/>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Route Row: Origin + dashed flight connector + Destination -->
                <HBox alignment="CENTER" spacing="6">
                    <!-- Origin -->
                    <VBox alignment="CENTER_LEFT" spacing="2">
                        <Label fx:id="originCodeLabel" text="" styleClass="ticket-airport-code"/>
                        <Label fx:id="originCityTimeLabel" text="" styleClass="ticket-city-time"/>
                    </VBox>

                    <!-- Connector with flight-path dashed line -->
                    <HBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Circle radius="3" styleClass="ticket-route-dot"/>
                        <Region minHeight="1.5" prefHeight="1.5" maxHeight="1.5" HBox.hgrow="ALWAYS"
                                styleClass="ticket-route-dash"/>
                        <Label fx:id="durationLabel" text="" minWidth="-Infinity" styleClass="ticket-duration-pill"/>
                        <Region minHeight="1.5" prefHeight="1.5" maxHeight="1.5" HBox.hgrow="ALWAYS"
                                styleClass="ticket-route-dash"/>
                        <SVGPath content="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"
                                 styleClass="ticket-route-plane"/>
                    </HBox>

                    <!-- Destination -->
                    <VBox alignment="CENTER_RIGHT" spacing="2">
                        <Label fx:id="destCodeLabel" text="" styleClass="ticket-airport-code"/>
                        <Label fx:id="destCityTimeLabel" text="" styleClass="ticket-city-time"/>
                    </VBox>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Bottom Section: Metadata Grid + Tightened Barcode Strip -->
                <VBox spacing="14">
                    <GridPane fx:id="metaGrid" hgap="6" vgap="4">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="126"/>
                            <ColumnConstraints prefWidth="74"/>
                            <ColumnConstraints prefWidth="104"/>
                            <ColumnConstraints prefWidth="76"/>
                        </columnConstraints>

                        <Label text="PASSENGER" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="ticket-grid-label"/>
                        <Label fx:id="passengerNameLabel" text="" wrapText="true"
                               GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="ticket-grid-value"/>

                        <Label text="FLIGHT" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="ticket-grid-label"/>
                        <Label fx:id="flightNumberLabel" text=""
                               GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="ticket-grid-value"/>

                        <Label text="DATE" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="ticket-grid-label"/>
                        <Label fx:id="flightDateLabel" text="" wrapText="true"
                               GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="ticket-grid-value"/>

                        <Label text="BOARDING" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="ticket-grid-label"/>
                        <Label fx:id="boardingTimeLabel" text=""
                               GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="ticket-grid-value"/>
                    </GridPane>

                    <!-- Barcode centered with tight white strip -->
                    <HBox alignment="CENTER">
                        <StackPane fx:id="barcodeContainer" styleClass="ticket-barcode-strip" alignment="CENTER">
                            <ImageView fx:id="barcodeImageView" fitHeight="44" preserveRatio="false" smooth="false"/>
                        </StackPane>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Vertical Tear-Off Perforation Line -->
            <Region fx:id="perforationDivider" prefWidth="1" minWidth="1" maxWidth="1"
                    prefHeight="575" minHeight="575" maxHeight="575"
                    styleClass="ticket-perf-line"/>

            <!-- 3. Right: Tear-Off Stub (190x575) -->
            <VBox fx:id="stubBox"
                  prefWidth="190" minWidth="190" maxWidth="190"
                  prefHeight="575" minHeight="575" maxHeight="575"
                  styleClass="ticket-stub-pane" style="-fx-padding: 24 20 20 20;">
                <!-- Top: SEAT -->
                <VBox spacing="2">
                    <Label text="SEAT" styleClass="ticket-seat-label"/>
                    <Label fx:id="stubSeatLabel" text="" styleClass="ticket-seat-value"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Middle: GATE -->
                <VBox spacing="3">
                    <Label text="GATE" styleClass="ticket-grid-label"/>
                    <Label fx:id="gateValueLabel" text="Shown at the airport" styleClass="ticket-stub-gate"/>
                    <Label fx:id="gateNoteLabel" text="Gate shown 60 min before departure." wrapText="true" styleClass="ticket-stub-note"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Bottom: REFERENCE -->
                <VBox spacing="2">
                    <Label text="REFERENCE" styleClass="ticket-grid-label"/>
                    <Label fx:id="stubReferenceLabel" text="" styleClass="ticket-stub-ref"/>
                </VBox>

                <!-- TOTAL FARE -->
                <VBox fx:id="stubFareContainer" spacing="2" visible="false" managed="false">
                    <Label text="TOTAL FARE" styleClass="ticket-grid-label"/>
                    <Label fx:id="stubFareLabel" text="" styleClass="ticket-stub-fare"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- Semicircle notch cutouts at perforation line (Offset: 190 from right) -->
        <Circle fx:id="topNotch" radius="14" styleClass="ticket-notch-circle"
                StackPane.alignment="TOP_RIGHT" translateX="-176" translateY="-14"/>
        <Circle fx:id="bottomNotch" radius="14" styleClass="ticket-notch-circle"
                StackPane.alignment="BOTTOM_RIGHT" translateX="-176" translateY="14"/>
        </StackPane>
    </Group>
</fx:root>
