<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.component.GlassTopBar?>
<?import com.group2.flightres.component.TicketView?>
<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.BookingConfirmationController"
                 photoPath="/com/group2/flightres/photos/dest-capetown.jpg"
                 blurRadius="0.0"
                 darkness="0.0"
                 saturation="0.0"
                 heroScrim="true"
                 enableSecondaryGlow="false"
                 stylesheets="@../css/glass.css"
                 styleClass="seat-map-glass-root"
                 prefWidth="1280"
                 prefHeight="800"
                 minWidth="1024"
                 minHeight="700">

    <VBox alignment="TOP_CENTER" spacing="0" prefWidth="1280" prefHeight="800" VBox.vgrow="ALWAYS">

        <!-- ===================================================================
             TOP NAV (64 high, web-parity GlassTopBar)
             =================================================================== -->
        <GlassTopBar fx:id="topBar" activeNav="my-bookings"/>

        <!-- ===================================================================
             MAIN CONTENT GLASS CARD (Margin 4 56 20 56)
             =================================================================== -->
        <StackPane fx:id="cardMarginWrapper" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="4" bottom="18" left="36" right="36"/>
            </VBox.margin>

            <!-- 1. ERROR STATE (Shown when booking not found / null context) -->
            <VBox fx:id="errorContainer" alignment="CENTER" spacing="20" visible="false" managed="false"
                  styleClass="glass-card, error-glass-card" maxWidth="800" maxHeight="450">
                <StackPane prefWidth="64" prefHeight="64" maxWidth="64" maxHeight="64"
                           style="-fx-background-color: rgba(239, 68, 68, 0.20); -fx-background-radius: 999px; -fx-border-color: rgba(239, 68, 68, 0.50); -fx-border-radius: 999px;">
                    <Label text="!" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #ef4444;"/>
                </StackPane>
                <Label fx:id="errorTitleLabel" text="We couldn't find your booking" styleClass="confirmation-title-serif"/>
                <Label fx:id="errorMessageLabel" text="No confirmed reservation details were found in this session. Please search and select a flight."
                       styleClass="confirmation-subtitle-mut" style="-fx-font-size: 15px;"/>
                <Button fx:id="errorBackButton" text="Back to Flight Search" onAction="#handleBackToHome"
                        styleClass="gold-primary-action-btn" prefWidth="240"/>
            </VBox>

            <!-- 2. CONFIRMED STATE (Shown when real booking exists) -->
            <VBox fx:id="confirmedContainer" spacing="14" styleClass="glass-card" style="-fx-padding: 18 22 18 22;" VBox.vgrow="ALWAYS">

                <!-- Header Row -->
                <HBox alignment="CENTER_LEFT" spacing="18">
                    <!-- Crisp white badge with dark checkmark matching board-7 -->
                    <StackPane styleClass="confirmation-emerald-circle">
                        <SVGPath content="M5 12l5 5 9-10" styleClass="confirmation-check-icon"/>
                    </StackPane>

                    <!-- Title block -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="confirmationTitleLabel" text="Your flight is booked" styleClass="confirmation-title-serif"/>
                        <Label fx:id="confirmationSubtitleLabel" text="" styleClass="confirmation-subtitle-mut"/>
                    </VBox>

                    <!-- Booking Reference Pill -->
                    <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="inner-card, glass-inner-panel"
                          style="-fx-padding: 8 20; -fx-background-color: rgba(8,12,22,0.45);">
                        <Label text="BOOKING REFERENCE" styleClass="ref-pill-label"/>
                        <Label fx:id="bookingRefLabel" text="" styleClass="ref-pill-code"/>
                    </VBox>
                </HBox>

                <!-- Responsive ScrollPane containing Two-Column or Single-Column Body -->
                <ScrollPane fx:id="confirmationScrollPane"
                            styleClass="confirmation-scroll-pane"
                            fitToWidth="true"
                            fitToHeight="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS">
                    <StackPane fx:id="scrollContentRoot" alignment="TOP_CENTER">
                        <!-- Two-Column Body (default for scene width >= 1100) -->
                        <HBox fx:id="twoColumnBox" spacing="24" alignment="CENTER_LEFT" fillHeight="false" VBox.vgrow="ALWAYS">

                            <!-- LEFT COLUMN: BOARDING PASS TICKET (scaled cleanly so 24px gap separates pass from sidebar) -->
                            <Group>
                                <TicketView fx:id="ticketView" scaleX="0.93" scaleY="0.93"/>
                            </Group>

                            <!-- RIGHT COLUMN: SIDEBAR (Width 340, zero overlap with pass) -->
                            <VBox fx:id="sidebarContainer" prefWidth="340" minWidth="320" maxWidth="350" spacing="12">

                                <!-- Payment Summary Panel: THREE ROWS (Base fare, Demand pricing, Booking time) then Paid -->
                                <VBox fx:id="paymentBox" spacing="8" styleClass="inner-card, glass-inner-panel" style="-fx-padding: 14 18;">
                                    <Label text="PAYMENT" styleClass="order-summary-overline"/>

                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Base fare" styleClass="confirmation-subtitle-mut"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="baseFareLabel" text="" style="-fx-font-family: 'Inter Medium'; -fx-font-size: 14px; -fx-text-fill: #ffffff;"/>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Demand pricing" styleClass="confirmation-subtitle-mut"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="demandPricingLabel" text="" style="-fx-font-family: 'Inter Medium'; -fx-font-size: 14px; -fx-text-fill: #ffffff;"/>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT">
                                        <Label text="Booking time" styleClass="confirmation-subtitle-mut"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="taxesFeesLabel" text="" style="-fx-font-family: 'Inter Medium'; -fx-font-size: 14px; -fx-text-fill: #ffffff;"/>
                                    </HBox>

                                    <Region prefHeight="1" style="-fx-background-color: rgba(255, 255, 255, 0.12);"/>

                                    <HBox alignment="BASELINE_LEFT">
                                        <Label text="Paid" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="totalPaidLabel" text="" styleClass="gold-total-text" style="-fx-font-size: 26px;"/>
                                    </HBox>
                                </VBox>

                                <!-- What Happens Next Panel -->
                                <VBox fx:id="nextStepsBox" spacing="10" VBox.vgrow="ALWAYS" styleClass="inner-card, glass-inner-panel" style="-fx-padding: 14 18;">
                                    <Label text="WHAT HAPPENS NEXT" styleClass="order-summary-overline"/>

                                    <!-- Step 1: Confirmed -->
                                    <HBox spacing="12" alignment="TOP_LEFT">
                                        <StackPane style="-fx-padding: 4 0 0 0;">
                                            <Region styleClass="timeline-dot-green"/>
                                        </StackPane>
                                        <VBox spacing="2">
                                            <Label text="Booking confirmed" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                            <Label fx:id="timelineSeatConfirmedLabel" text="" styleClass="confirmation-subtitle-mut" style="-fx-font-size: 12px;"/>
                                        </VBox>
                                    </HBox>

                                    <!-- Step 2: Check-in -->
                                    <HBox spacing="12" alignment="TOP_LEFT">
                                        <StackPane style="-fx-padding: 4 0 0 0;">
                                            <Region styleClass="timeline-dot-gold"/>
                                        </StackPane>
                                        <VBox spacing="2">
                                            <Label text="Online check-in" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                            <Label fx:id="timelineCheckinLabel" text="" styleClass="confirmation-subtitle-mut" style="-fx-font-size: 12px;"/>
                                        </VBox>
                                    </HBox>

                                    <!-- Step 3: Bag drop -->
                                    <HBox spacing="12" alignment="TOP_LEFT">
                                        <StackPane style="-fx-padding: 4 0 0 0;">
                                            <Region styleClass="timeline-dot-gray"/>
                                        </StackPane>
                                        <VBox spacing="2">
                                            <Label text="Bag drop closes" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                            <Label fx:id="timelineBagDropLabel" text="" styleClass="confirmation-subtitle-mut" style="-fx-font-size: 12px;"/>
                                        </VBox>
                                    </HBox>
                                </VBox>

                                <!-- Download PDF Button -->
                                <Button fx:id="downloadPdfButton" text="Download boarding pass (PDF)"
                                        onAction="#handleDownloadPdf"
                                        styleClass="gold-primary-action-btn" maxWidth="Infinity">
                                    <graphic>
                                        <SVGPath content="M12 4v11M7 11l5 5 5-5M5 20h14"
                                                 style="-fx-stroke: #0b1220; -fx-stroke-width: 2.4; -fx-fill: transparent; -fx-stroke-linecap: round; -fx-stroke-linejoin: round;"/>
                                    </graphic>
                                </Button>

                                <!-- Add to calendar & Manage booking buttons -->
                                <HBox fx:id="buttonRow" spacing="10">
                                    <Button fx:id="addToCalendarButton" text="Add to calendar"
                                            onAction="#handleAddToCalendar"
                                            styleClass="secondary-glass-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                    <!-- Manage booking hidden for now per spec -->
                                    <Button fx:id="manageBookingButton" text="Manage booking"
                                            visible="false" managed="false"
                                            styleClass="secondary-glass-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Single-Column Body (used when scene width < 1100) -->
                        <VBox fx:id="singleColumnBox" spacing="16" alignment="TOP_CENTER" visible="false" managed="false"/>
                    </StackPane>
                </ScrollPane>
            </VBox>
        </StackPane>
    </VBox>
</GlassBackground>
