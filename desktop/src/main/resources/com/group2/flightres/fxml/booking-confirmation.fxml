<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.BookingConfirmationController"
                 photoPath="/com/group2/flightres/photos/dest-capetown.jpg"
                 blurRadius="26.0"
                 darkness="-0.50"
                 saturation="0.20"
                 linearOverlay="linear-gradient(to bottom, rgba(11,18,32,0.40) 0%, rgba(11,18,32,0.74) 100%)"
                 radialGlow="radial-gradient(center 50% 0%, radius 45%, rgba(22,163,74,0.16) 0%, transparent 100%)"
                 enableSecondaryGlow="true"
                 stylesheets="@../css/glass.css"
                 styleClass="seat-map-glass-root"
                 prefWidth="1280"
                 prefHeight="860"
                 minWidth="1280"
                 minHeight="860"
                 maxWidth="1280"
                 maxHeight="860">

    <VBox alignment="TOP_CENTER" spacing="0" prefWidth="1280" prefHeight="860" minWidth="1280" minHeight="860" maxWidth="1280" maxHeight="860">

        <!-- ===================================================================
             TOP NAV (64 high, padding 0 56)
             =================================================================== -->
        <HBox alignment="CENTER_LEFT" prefHeight="64" minHeight="64" maxHeight="64" styleClass="glass-nav-bar">
            <!-- Brand: gold plane icon + BrandConfig.APP_NAME -->
            <HBox alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleNavHome" style="-fx-cursor: hand;">
                <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" styleClass="nav-brand-plane"/>
                <Label styleClass="nav-brand-text">
                    <text><BrandConfig fx:constant="APP_NAME"/></text>
                </Label>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Center nav links: Flights, My Bookings (active), Offers, About, Contact -->
            <HBox alignment="CENTER" spacing="30" styleClass="glass-nav-links-box">
                <Button text="Flights" styleClass="glass-nav-link" onAction="#handleNavFlights"/>
                <Button text="My Bookings" styleClass="glass-nav-link, glass-nav-link-active" onAction="#handleComingSoonMyBookings"/>
                <Button text="Offers" styleClass="glass-nav-link" onAction="#handleComingSoonOffers"/>
                <Button text="About" styleClass="glass-nav-link" onAction="#handleNavAbout"/>
                <Button text="Contact" styleClass="glass-nav-link" onAction="#handleNavContact"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- User avatar -->
            <HBox alignment="CENTER_RIGHT" prefWidth="100">
                <StackPane styleClass="glass-avatar-circle" onMouseClicked="#handleNavAvatar" style="-fx-cursor: hand;">
                    <Label fx:id="avatarInitialsLabel" text="AM" styleClass="glass-avatar-text"/>
                </StackPane>
            </HBox>
        </HBox>

        <!-- ===================================================================
             MAIN CONTENT GLASS CARD (Margin 4 56 32 56)
             =================================================================== -->
        <StackPane VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="4" bottom="28" left="56" right="56"/>
            </VBox.margin>

            <!-- 1. ERROR STATE (Shown when booking not found / null context) -->
            <VBox fx:id="errorContainer" alignment="CENTER" spacing="20" visible="false" managed="false"
                  styleClass="glass-card, error-glass-card" maxWidth="800" maxHeight="450">
                <StackPane prefWidth="64" prefHeight="64" maxWidth="64" maxHeight="64"
                           style="-fx-background-color: rgba(239, 68, 68, 0.20); -fx-background-radius: 999px; -fx-border-color: rgba(239, 68, 68, 0.50); -fx-border-radius: 999px;">
                    <Label text="!" style="-fx-font-size: 32px; -fx-font-weight: 700; -fx-text-fill: #ef4444;"/>
                </StackPane>
                <Label text="We couldn't find your booking" styleClass="confirmation-title-serif"/>
                <Label text="No confirmed reservation details were found in this session. Please search and select a flight."
                       styleClass="confirmation-subtitle-mut" style="-fx-font-size: 15px;"/>
                <Button fx:id="errorBackButton" text="Back to Flight Search" onAction="#handleBackToHome"
                        styleClass="gold-primary-action-btn" prefWidth="240"/>
            </VBox>

            <!-- 2. CONFIRMED STATE (Shown when real booking exists) -->
            <VBox fx:id="confirmedContainer" spacing="20" styleClass="glass-card" style="-fx-padding: 26 34 26 34;">

                <!-- Header Row -->
                <HBox alignment="CENTER_LEFT" spacing="18">
                    <!-- Emerald glowing circle with checkmark -->
                    <StackPane styleClass="confirmation-emerald-circle">
                        <SVGPath content="M5 12l5 5 9-10"
                                 style="-fx-stroke: #ffffff; -fx-stroke-width: 3.2; -fx-fill: transparent; -fx-stroke-linecap: round; -fx-stroke-linejoin: round;"/>
                    </StackPane>

                    <!-- Title block -->
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="confirmationTitleLabel" text="Your flight is booked" styleClass="confirmation-title-serif"/>
                        <Label fx:id="confirmationSubtitleLabel" text="Booking confirmation for amahle@example.com"
                               styleClass="confirmation-subtitle-mut"/>
                    </VBox>

                    <!-- Booking Reference Pill -->
                    <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="inner-card, glass-inner-panel"
                          style="-fx-padding: 10 22; -fx-background-color: rgba(8,12,22,0.45);">
                        <Label text="BOOKING REFERENCE" styleClass="ref-pill-label"/>
                        <Label fx:id="bookingRefLabel" text="K7QX2M" styleClass="ref-pill-code"/>
                    </VBox>
                </HBox>

                <!-- Two-Column Body -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">

                    <!-- =========================================================
                         LEFT COLUMN: BOARDING PASS TICKET
                         ========================================================= -->
                    <StackPane fx:id="ticketWrapperPane" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">

                        <!-- Main Ticket Box (Left card + Perforation + Stub) -->
                        <HBox fx:id="ticketCardBox" styleClass="ticket-card" HBox.hgrow="ALWAYS">

                            <!-- Left: Boarding Details Section -->
                            <VBox HBox.hgrow="ALWAYS" style="-fx-padding: 24 28 20 28;">

                                <!-- Header: Overline + Cabin Badge -->
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="BOARDING DETAILS" styleClass="ticket-grid-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="cabinBadgeLabel" text="Economy" styleClass="ticket-cabin-badge"/>
                                </HBox>

                                <Region VBox.vgrow="ALWAYS"/>

                                <!-- Route Row: JNB ──── 2h 05m ────✈ CPT (vertically centered) -->
                                <HBox alignment="CENTER" spacing="16">
                                    <!-- Origin -->
                                    <VBox alignment="CENTER_LEFT" spacing="2">
                                        <Label fx:id="originCodeLabel" text="JNB" styleClass="ticket-airport-code"/>
                                        <Label fx:id="originCityTimeLabel" text="Johannesburg · 06:30" styleClass="ticket-city-time"/>
                                    </VBox>

                                    <!-- Connector with flight-path dashed line -->
                                    <HBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS">
                                        <Circle radius="4" style="-fx-fill: #e8c46a;"/>
                                        <Region minHeight="1.5" prefHeight="1.5" maxHeight="1.5" HBox.hgrow="ALWAYS"
                                                style="-fx-border-color: rgba(255,255,255,0.35); -fx-border-style: dashed; -fx-border-width: 1.5 0 0 0;"/>
                                        <Label fx:id="durationLabel" text="2h 05m" styleClass="ticket-duration-pill"/>
                                        <Region minHeight="1.5" prefHeight="1.5" maxHeight="1.5" HBox.hgrow="ALWAYS"
                                                style="-fx-border-color: rgba(255,255,255,0.35); -fx-border-style: dashed; -fx-border-width: 1.5 0 0 0;"/>
                                        <SVGPath content="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"
                                                 style="-fx-fill: #e8c46a; -fx-rotate: 90;"/>
                                    </HBox>

                                    <!-- Destination -->
                                    <VBox alignment="CENTER_RIGHT" spacing="2">
                                        <Label fx:id="destCodeLabel" text="CPT" styleClass="ticket-airport-code"/>
                                        <Label fx:id="destCityTimeLabel" text="Cape Town · 08:35" styleClass="ticket-city-time"/>
                                    </VBox>
                                </HBox>

                                <Region VBox.vgrow="ALWAYS"/>

                                <!-- Bottom Section: Metadata Grid + Crisp Barcode -->
                                <VBox spacing="18">
                                    <GridPane hgap="16" vgap="4">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="38"/>
                                            <ColumnConstraints percentWidth="18"/>
                                            <ColumnConstraints percentWidth="26"/>
                                            <ColumnConstraints percentWidth="18"/>
                                        </columnConstraints>

                                        <Label text="PASSENGER" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="ticket-grid-label"/>
                                        <Label fx:id="passengerNameLabel" text="Ms Amahle Mokoena" wrapText="true" textOverrun="CLIP"
                                               GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="ticket-grid-value"/>

                                        <Label text="FLIGHT" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="ticket-grid-label"/>
                                        <Label fx:id="flightNumberLabel" text="FL 204" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="ticket-grid-value"/>

                                        <Label text="DATE" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="ticket-grid-label"/>
                                        <Label fx:id="flightDateLabel" text="Sat, 14 Nov 2026" wrapText="true" textOverrun="CLIP"
                                               GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="ticket-grid-value"/>

                                        <Label text="BOARDING" GridPane.columnIndex="3" GridPane.rowIndex="0" styleClass="ticket-grid-label"/>
                                        <Label fx:id="boardingTimeLabel" text="06:00" GridPane.columnIndex="3" GridPane.rowIndex="1" styleClass="ticket-grid-value"/>
                                    </GridPane>

                                    <!-- Real Code 128 Barcode: fill ticket-body width, 48px tall, crisp, centered with >16px spacing -->
                                    <VBox alignment="CENTER" spacing="0" HBox.hgrow="ALWAYS" style="-fx-padding: 8 0 0 0;">
                                        <ImageView fx:id="barcodeImageView" fitHeight="48" preserveRatio="false" smooth="false"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <!-- Vertical Tear-Off Perforation Line -->
                            <Region fx:id="perforationDivider" prefWidth="1" minWidth="1" maxWidth="1"
                                    style="-fx-border-color: rgba(255,255,255,0.28); -fx-border-style: dashed; -fx-border-width: 0 0 0 2;"/>

                            <!-- Right: Tear-Off Stub -->
                            <VBox fx:id="stubBox" prefWidth="220" minWidth="220" maxWidth="220"
                                  styleClass="ticket-stub-pane" style="-fx-padding: 24 24 20 24;">
                                <!-- Top: SEAT -->
                                <VBox spacing="2">
                                    <Label text="SEAT" styleClass="ticket-seat-label"/>
                                    <Label fx:id="stubSeatLabel" text="9E" styleClass="ticket-seat-value"/>
                                </VBox>

                                <Region VBox.vgrow="ALWAYS"/>

                                <!-- Middle: GATE and status -->
                                <VBox spacing="4">
                                    <Label text="GATE" styleClass="ticket-grid-label"/>
                                    <Label fx:id="gateValueLabel" text="Shown at the airport"
                                           style="-fx-font-family: 'Inter'; -fx-font-size: 16px; -fx-font-weight: 700; -fx-text-fill: #ffffff;"/>
                                </VBox>

                                <Region VBox.vgrow="ALWAYS"/>

                                <!-- Bottom: Note -->
                                <Label fx:id="gateNoteLabel" text="Gate shown 60 min before departure."
                                       wrapText="true" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.60); -fx-line-spacing: 2;"/>
                            </VBox>
                        </HBox>

                        <!-- Semicircle notch cutouts at perforation line -->
                        <Circle fx:id="topNotch" radius="14" styleClass="ticket-notch-circle" StackPane.alignment="TOP_RIGHT"/>
                        <Circle fx:id="bottomNotch" radius="14" styleClass="ticket-notch-circle" StackPane.alignment="BOTTOM_RIGHT"/>
                    </StackPane>

                    <!-- =========================================================
                         RIGHT COLUMN: SIDEBAR (Width 340)
                         ========================================================= -->
                    <VBox prefWidth="340" minWidth="340" maxWidth="340" spacing="14">

                        <!-- Payment Summary Panel: THREE ROWS (Base fare, Demand pricing, Taxes and fees) then Paid -->
                        <VBox spacing="8" styleClass="inner-card, glass-inner-panel" style="-fx-padding: 16 20;">
                            <Label text="PAYMENT" styleClass="order-summary-overline"/>

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Base fare" styleClass="confirmation-subtitle-mut"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="baseFareLabel" text="R 1,200" style="-fx-font-family: 'Inter Medium'; -fx-font-size: 14px; -fx-text-fill: #ffffff;"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Demand pricing" styleClass="confirmation-subtitle-mut"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="demandPricingLabel" text="R 180" style="-fx-font-family: 'Inter Medium'; -fx-font-size: 14px; -fx-text-fill: #ffffff;"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Taxes and fees" styleClass="confirmation-subtitle-mut"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="taxesFeesLabel" text="R 142" style="-fx-font-family: 'Inter Medium'; -fx-font-size: 14px; -fx-text-fill: #ffffff;"/>
                            </HBox>

                            <Region prefHeight="1" style="-fx-background-color: rgba(255, 255, 255, 0.12);"/>

                            <HBox alignment="BASELINE_LEFT">
                                <Label text="Paid" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="totalPaidLabel" text="R 1,522" styleClass="gold-total-text" style="-fx-font-size: 26px;"/>
                            </HBox>
                        </VBox>

                        <!-- What Happens Next Panel -->
                        <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="inner-card, glass-inner-panel" style="-fx-padding: 16 20;">
                            <Label text="WHAT HAPPENS NEXT" styleClass="order-summary-overline"/>

                            <!-- Step 1: Confirmed -->
                            <HBox spacing="12" alignment="TOP_LEFT">
                                <StackPane style="-fx-padding: 4 0 0 0;">
                                    <Region styleClass="timeline-dot-green"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Booking confirmed" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                    <Label fx:id="timelineSeatConfirmedLabel" text="Seat 9E is yours" styleClass="confirmation-subtitle-mut" style="-fx-font-size: 12px;"/>
                                </VBox>
                            </HBox>

                            <!-- Step 2: Check-in -->
                            <HBox spacing="12" alignment="TOP_LEFT">
                                <StackPane style="-fx-padding: 4 0 0 0;">
                                    <Region styleClass="timeline-dot-gold"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Online check-in" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                    <Label fx:id="timelineCheckinLabel" text="Opens Thu, 13 Nov at 06:30" styleClass="confirmation-subtitle-mut" style="-fx-font-size: 12px;"/>
                                </VBox>
                            </HBox>

                            <!-- Step 3: Bag drop -->
                            <HBox spacing="12" alignment="TOP_LEFT">
                                <StackPane style="-fx-padding: 4 0 0 0;">
                                    <Region styleClass="timeline-dot-gray"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Bag drop closes" style="-fx-font-family: 'Inter SemiBold'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                                    <Label fx:id="timelineBagDropLabel" text="05:30 at O.R. Tambo" styleClass="confirmation-subtitle-mut" style="-fx-font-size: 12px;"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Download PDF Button -->
                        <Button fx:id="downloadPdfButton" text="Download boarding pass (PDF)"
                                onAction="#handleDownloadPdf"
                                styleClass="gold-primary-action-btn" maxWidth="Infinity">
                            <graphic>
                                <SVGPath content="M12 4v11M7 11l5 5 5-5M5 20h14"
                                         style="-fx-stroke: #0b1220; -fx-stroke-width: 2.4; -fx-fill: transparent; -fx-stroke-linecap: round; -fx-stroke-linejoin: round;"/>
                            </graphic>
                        </Button>

                        <!-- Add to calendar & Manage booking buttons -->
                        <HBox spacing="10">
                            <Button fx:id="addToCalendarButton" text="Add to calendar"
                                    onAction="#handleAddToCalendar"
                                    styleClass="secondary-glass-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <!-- Manage booking hidden for now per spec -->
                            <Button fx:id="manageBookingButton" text="Manage booking"
                                    visible="false" managed="false"
                                    styleClass="secondary-glass-btn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </VBox>
</GlassBackground>
