<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.component.GlassTopBar?>
<?import com.group2.flightres.component.StepperBar?>
<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.CheckoutController"
                 photoPath="/com/group2/flightres/photos/aerial-2.jpg"
                 blurRadius="0.0"
                 darkness="0.0"
                 saturation="0.0"
                 enableSecondaryGlow="false"
                 stylesheets="@../css/glass.css"
                 styleClass="seat-map-glass-root"
                 prefWidth="1280"
                 prefHeight="760"
                 minWidth="860"
                 minHeight="620">

    <VBox alignment="TOP_CENTER" spacing="0" VBox.vgrow="ALWAYS">

        <!-- ===================================================================
             TOP NAV (54 high, web-parity GlassTopBar)
             =================================================================== -->
        <GlassTopBar fx:id="topBar" activeNav="flights"/>

        <!-- ===================================================================
             MAIN GLASS CARD (responsive from 900 to 1920 wide)
             =================================================================== -->
        <VBox VBox.vgrow="ALWAYS" spacing="10" styleClass="search-main-glass"
              maxWidth="1168">
            <VBox.margin>
                <Insets top="4" right="20" bottom="16" left="20"/>
            </VBox.margin>

            <!-- 1. Stepper Bar (height 46, inner card) -->
            <HBox alignment="CENTER" prefHeight="46" minHeight="46" maxHeight="46" styleClass="glass-stepper-card">
                <StepperBar fx:id="stepperBar" alignment="CENTER" prefHeight="46"/>
            </HBox>

            <!-- 2. Main Split: Left Column (flex) + Right Column (flex) -->
            <HBox VBox.vgrow="ALWAYS" spacing="12" minHeight="0">

                <!-- =======================================================
                     LEFT COLUMN: Trip Card + Passenger Details Card
                     ======================================================= -->
                <VBox prefWidth="400" minWidth="320" maxWidth="500" HBox.hgrow="SOMETIMES" spacing="10">

                    <!-- A. Trip Card -->
                    <VBox styleClass="inner-card" style="-fx-padding: 0; -fx-background-radius: 16px; -fx-border-radius: 16px;">
                        <!-- Trip Hero Photo Banner -->
                        <StackPane prefHeight="132" minHeight="132" maxHeight="132" minWidth="0">
                            <ImageView fx:id="tripHeroImageView" managed="false" fitWidth="500" fitHeight="132" preserveRatio="false" opacity="0.32"/>
                            <Region style="-fx-background-color: linear-gradient(to bottom, rgba(11,18,32,0.10) 0%, rgba(11,18,32,0.85) 100%); -fx-background-radius: 16 16 0 0;"/>
                            <VBox alignment="CENTER_LEFT" spacing="0" style="-fx-padding: 14px 18px;">
                                <HBox alignment="CENTER_LEFT">
                                    <Label text="YOUR TRIP" styleClass="section-badge-gold" style="-fx-text-fill: rgba(255,255,255,0.90);"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="tripDateBadge" text="Sat, 14 Nov 2026"
                                           style="-fx-background-color: rgba(255,255,255,0.20); -fx-background-radius: 999px; -fx-padding: 4px 10px; -fx-text-fill: #ffffff; -fx-font-family: 'Inter SemiBold', sans-serif; -fx-font-size: 11px;"/>
                                </HBox>
                                <Region VBox.vgrow="ALWAYS"/>
                                <Label text="FROM JOHANNESBURG TO" style="-fx-font-size: 10px; -fx-font-family: 'Inter Medium', sans-serif; -fx-text-fill: rgba(255,255,255,0.85); -fx-letter-spacing: 0.14em;"/>
                                <Label fx:id="tripOriginDestLabel" text="Cape Town" style="-fx-font-family: 'Inter Bold', 'Inter', sans-serif; -fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #ffffff;"/>
                            </VBox>
                        </StackPane>

                        <!-- Times & Route Line -->
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12px 18px 4px 18px;">
                            <VBox spacing="2" minWidth="86">
                                <Label fx:id="tripDepTimeLabel" text="" style="-fx-font-family: 'Inter Bold', sans-serif; -fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #ffffff;"/>
                                <Label fx:id="tripOriginSubLabel" text="" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.58);"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" alignment="CENTER" spacing="3">
                                <Label fx:id="tripDurationLabel" text="" style="-fx-font-family: 'Inter SemiBold', sans-serif; -fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: rgba(255,255,255,0.58);"/>
                                <HBox alignment="CENTER" spacing="5" maxWidth="Infinity">
                                    <Region style="-fx-pref-width: 6px; -fx-pref-height: 6px; -fx-background-color: -glass-cream; -fx-background-radius: 50%;"/>
                                    <Region HBox.hgrow="ALWAYS" style="-fx-border-color: rgba(255,255,255,0.35); -fx-border-width: 1.5 0 0 0; -fx-border-style: dashed;"/>
                                    <SVGPath content="M21 16v-2l-8-5V3.5a1.5 1.5 0 00-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5z"
                                             fill="#4da3ff" scaleX="0.7" scaleY="0.7" rotate="90"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="2" alignment="TOP_RIGHT" minWidth="86">
                                <Label fx:id="tripArrTimeLabel" text="" style="-fx-font-family: 'Inter Bold', sans-serif; -fx-font-size: 22px; -fx-font-weight: 700; -fx-text-fill: #ffffff;"/>
                                <Label fx:id="tripDestSubLabel" text="" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.58);"/>
                            </VBox>
                        </HBox>

                        <!-- Dashed Divider -->
                        <Region style="-fx-border-color: rgba(255,255,255,0.18); -fx-border-width: 1.5 0 0 0; -fx-border-style: dashed; -fx-margin: 8px 18px 0 18px;"/>

                        <!-- Flight / Seat / Baggage Metadata Grid -->
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 10px 18px 12px 18px;">
                            <VBox HBox.hgrow="ALWAYS" spacing="2">
                                <Label text="Flight" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.58);"/>
                                <Label fx:id="tripFlightLabel" text="" style="-fx-font-family: 'Inter SemiBold', sans-serif; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="2">
                                <Label text="Seat" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.58);"/>
                                <Label fx:id="tripSeatLabel" text="" style="-fx-font-family: 'Inter SemiBold', sans-serif; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: -glass-cream;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" spacing="2">
                                <Label text="Baggage" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.58);"/>
                                <Label fx:id="baggageAllowanceLabel" text="" style="-fx-font-family: 'Inter SemiBold', sans-serif; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- B. Passenger Details Card -->
                    <VBox VBox.vgrow="ALWAYS" styleClass="inner-card" style="-fx-padding: 14px 18px;" spacing="10">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Passenger" style="-fx-font-family: 'Inter SemiBold', sans-serif; -fx-font-size: 16px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Adult 1 of 1"
                                   style="-fx-background-color: rgba(241, 238, 223, 0.20); -fx-background-radius: 999px; -fx-padding: 4px 11px; -fx-text-fill: -glass-cream; -fx-font-family: 'Inter SemiBold', sans-serif; -fx-font-size: 12px;"/>
                        </HBox>

                        <GridPane hgap="10" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <!-- First name -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="First name" style="-fx-font-family: 'Inter Medium', sans-serif; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                                <TextField fx:id="firstNameField" promptText="First name" styleClass="checkout-input"/>
                            </VBox>

                            <!-- Last name -->
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Last name" style="-fx-font-family: 'Inter Medium', sans-serif; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                                <TextField fx:id="lastNameField" promptText="Last name" styleClass="checkout-input"/>
                            </VBox>

                            <!-- Passport number -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label text="Passport number" style="-fx-font-family: 'Inter Medium', sans-serif; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                                <TextField fx:id="passportField" promptText="A91827364" styleClass="checkout-input"/>
                            </VBox>

                            <!-- Date of birth -->
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <Label text="Date of birth" style="-fx-font-family: 'Inter Medium', sans-serif; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                                <TextField fx:id="dobField" promptText="12 May 1998" styleClass="checkout-input"/>
                            </VBox>

                            <!-- Email (span 2 columns) -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                <Label text="Email for your boarding pass" style="-fx-font-family: 'Inter Medium', sans-serif; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                                <TextField fx:id="emailField" promptText="passenger@example.com" styleClass="checkout-input"/>
                            </VBox>
                        </GridPane>

                        <!-- Preserved existing baseline controls (managed=false, invisible) -->
                        <TextField fx:id="fullNameField" visible="false" managed="false"/>
                        <Label fx:id="flightLabel" visible="false" managed="false"/>
                        <Label fx:id="departsLabel" visible="false" managed="false"/>
                        <Label fx:id="passengerLabel" visible="false" managed="false"/>
                        <Label fx:id="seatLabel" visible="false" managed="false"/>
                    </VBox>
                </VBox>

                <!-- =======================================================
                     RIGHT COLUMN: Payment Method Card + Order Summary Card
                     ======================================================= -->
                <VBox HBox.hgrow="ALWAYS" spacing="10" minWidth="360">

                    <!-- A. Payment Method Card -->
                    <VBox styleClass="inner-card" style="-fx-padding: 14px 18px;" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Payment method" minWidth="-Infinity" style="-fx-font-family: 'Inter SemiBold', sans-serif; -fx-font-size: 15px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                            <Region HBox.hgrow="ALWAYS"/>

                            <HBox styleClass="demo-payment-badge" alignment="CENTER" minWidth="-Infinity">
                                <Label text="Demo payment, no real card is charged" minWidth="-Infinity" styleClass="demo-payment-text"/>
                            </HBox>
                        </HBox>

                        <!-- Payment Method: Card (only) -->
                        <HBox styleClass="tab-group" spacing="4">
                            <Button fx:id="cardTabButton" text="Card" styleClass="tab-btn, tab-btn-active" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#handleCardTab"/>
                        </HBox>

                        <!-- Card Preview + Card Form Inputs -->
                        <HBox spacing="12" alignment="CENTER_LEFT">

                            <!-- Live Credit Card Preview (Always Cream with metallic chip & brand matching web) -->
                            <VBox styleClass="paycard, paycard-cream" prefWidth="200" minWidth="190" maxWidth="216" prefHeight="136" minHeight="136" maxHeight="136"
                                  spacing="0">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Region styleClass="paycard-chip" prefWidth="30" minWidth="30" maxWidth="30" prefHeight="20" minHeight="20" maxHeight="20"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="VISA" styleClass="paycard-brand"/>
                                    <Label text="DEMO" styleClass="paycard-demo-tag"/>
                                </HBox>
                                <Region VBox.vgrow="ALWAYS"/>
                                <Label fx:id="cardPreviewNumber" text="•••• •••• •••• 4242" styleClass="paycard-number"/>
                                <Region VBox.vgrow="ALWAYS"/>
                                <HBox alignment="CENTER_LEFT">
                                    <Label fx:id="cardPreviewHolder" text="AMAHLE MOKOENA" styleClass="paycard-meta"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="cardPreviewExpiry" text="08 / 28" styleClass="paycard-meta"/>
                                </HBox>
                            </VBox>

                            <!-- Card Inputs Form -->
                            <VBox HBox.hgrow="ALWAYS" spacing="8" alignment="CENTER_LEFT" minWidth="140">
                                <VBox spacing="3">
                                    <Label text="Card number" style="-fx-font-family: 'Inter Medium', sans-serif; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                                    <TextField fx:id="cardNumberField" promptText="4242 4242 4242 4242" styleClass="checkout-input"/>
                                </VBox>
                                <HBox spacing="8">
                                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                                        <Label text="Expiry" style="-fx-font-family: 'Inter Medium', sans-serif; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                                        <TextField fx:id="expiryField" promptText="08 / 28" styleClass="checkout-input"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" spacing="3">
                                        <Label text="CVV" style="-fx-font-family: 'Inter Medium', sans-serif; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.65);"/>
                                        <PasswordField fx:id="cvvField" promptText="123" styleClass="checkout-input"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- B. Order Summary Card -->
                    <VBox VBox.vgrow="ALWAYS" styleClass="order-summary-card" style="-fx-padding: 14px 18px;" spacing="0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="ORDER SUMMARY" styleClass="order-summary-overline"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="orderSummaryBadge" text=""
                                   style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 999px; -fx-padding: 4px 10px; -fx-text-fill: #ffffff; -fx-font-family: 'Inter SemiBold', sans-serif; -fx-font-size: 12px;"/>
                        </HBox>

                        <VBox spacing="4" style="-fx-padding: 10px 0 0 0;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Base fare" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.72);"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="baseFareLabel" text="" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.72);"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Demand pricing" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.72);"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="demandPricingLabel" text="" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.72);"/>
                            </HBox>
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Taxes and fees" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.72);"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="taxesFeesLabel" text="" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.72);"/>
                            </HBox>
                        </VBox>

                        <Region style="-fx-background-color: rgba(255,255,255,0.16); -fx-pref-height: 1px; -fx-margin: 8px 0;"/>

                        <HBox alignment="BASELINE_LEFT">
                            <Label text="Total payable" style="-fx-font-family: 'Inter SemiBold', 'Inter', sans-serif; -fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #ffffff;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="totalLabel" text="" styleClass="gold-total-text"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="vatIncludedLabel" text="" style="-fx-font-family: 'Inter', sans-serif; -fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.62);"/>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <!-- Primary Confirm and Pay Button (Height 44) -->
                        <Button fx:id="confirmBookingButton" text="" onAction="#handleConfirm"
                                prefHeight="44" minHeight="44" maxHeight="44" maxWidth="Infinity"
                                styleClass="btn-checkout-gold">
                            <graphic>
                                <HBox alignment="CENTER" spacing="10" maxWidth="Infinity">
                                    <Label text="Confirm and pay" minWidth="-Infinity" style="-fx-font-family: 'Inter Bold', sans-serif; -fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: -glass-ink;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="confirmTotalLabel" text="" minWidth="-Infinity" style="-fx-font-family: 'Inter Bold', sans-serif; -fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: -glass-ink;"/>
                                    <SVGPath content="M9 6l6 6-6 6" stroke="#15181c" strokeWidth="2.4" fill="transparent"/>
                                </HBox>
                            </graphic>
                        </Button>

                        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 8px 0 0 0;">
                            <Button fx:id="backButton" text="Back to seat map" onAction="#handleBack"
                                    prefHeight="36" minHeight="36" maxHeight="36" minWidth="-Infinity"
                                    styleClass="btn-release-ghost"/>
                            <Label fx:id="holdTimerLabel"
                                   text="Seat held for 04:42"
                                   alignment="CENTER" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                   styleClass="checkout-hold-pill"/>
                        </HBox>
                        <VBox fx:id="errorContainer" visible="false" managed="false" styleClass="glass-card" style="-fx-padding: 20px; -fx-background-color: rgba(239, 68, 68, 0.15); -fx-border-color: rgba(239, 68, 68, 0.5); -fx-border-radius: 12px; -fx-background-radius: 12px;" spacing="10" alignment="CENTER">
                            <Label fx:id="errorMessageLabel" text="" visible="false" managed="false" wrapText="true" style="-fx-font-family: 'Inter Medium'; -fx-font-size: 14px; -fx-text-fill: #fca5a5; -fx-alignment: CENTER;"/>
                            <Button fx:id="errorBackButton" text="Back to seat map" onAction="#handleBack" visible="false" managed="false" styleClass="btn-release-ghost" prefWidth="200"/>
                        </VBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</GlassBackground>
