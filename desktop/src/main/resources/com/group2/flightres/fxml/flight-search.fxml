<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.component.GlassTopBar?>
<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import com.group2.flightres.util.GlassFlightResultsBridge?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.FlightSearchController"
                 photoPath="/com/group2/flightres/photos/aerial-1.jpg"
                 blurRadius="0.0"
                 darkness="0.0"
                 saturation="0.0"
                 enableSecondaryGlow="false"
                 stylesheets="@../css/glass.css"
                 styleClass="flight-search-root"
                 prefWidth="1280"
                 prefHeight="800"
                 minWidth="1024"
                 minHeight="700">

    <VBox alignment="TOP_CENTER" spacing="0" VBox.vgrow="ALWAYS">

        <!-- ===================================================================
             TOP NAV (64 high, web-parity GlassTopBar)
             =================================================================== -->
        <GlassTopBar fx:id="topBar" activeNav="flights"/>

        <!-- ===================================================================
             MAIN GLASS CARD (margins: left/right 56, top 4, bottom 32; padding 14, gap 14)
             =================================================================== -->
        <VBox styleClass="search-main-glass"
              spacing="14"
              VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="4" right="56" bottom="32" left="56"/>
            </VBox.margin>

            <!-- ==============================================================-
                 SEARCH BAR (inner card, 84 high)
                 ==============================================================- -->
            <HBox alignment="CENTER_LEFT" prefHeight="84" minHeight="84" maxHeight="84" styleClass="glass-search-bar">

                <!-- FROM Cell -->
                <VBox alignment="CENTER_LEFT" spacing="3" styleClass="search-cell" HBox.hgrow="ALWAYS" prefWidth="240">
                    <Label text="From" styleClass="search-cell-muted-label"/>
                    <Label fx:id="fromCityDisplay" text="" styleClass="search-cell-value-label"/>
                    <Label fx:id="fromSubDisplay" text="" styleClass="search-cell-sub-label"/>
                    <!-- Invisible ComboBox for logic freeze compatibility -->
                    <ComboBox fx:id="fromCombo" visible="false" managed="false" minHeight="0" prefHeight="0" maxHeight="0"/>
                </VBox>

                <!-- SWAP Button (32px diameter circle) -->
                <StackPane>
                    <HBox.margin>
                        <Insets left="-16" right="-16"/>
                    </HBox.margin>
                    <Button onAction="#handleSwapLocations" styleClass="search-swap-btn">
                        <graphic>
                            <SVGPath content="M7 4L3 8l4 4M3 8h14M17 20l4-4-4-4M21 16H7"
                                     stroke="WHITE" strokeWidth="2" strokeLineCap="ROUND" strokeLineJoin="ROUND" fill="TRANSPARENT"
                                     scaleX="0.7" scaleY="0.7"/>
                        </graphic>
                    </Button>
                </StackPane>

                <!-- TO Cell -->
                <VBox alignment="CENTER_LEFT" spacing="3" styleClass="search-cell, search-cell-border" HBox.hgrow="ALWAYS" prefWidth="240">
                    <padding>
                        <Insets top="14" right="18" bottom="14" left="30"/>
                    </padding>
                    <Label text="To" styleClass="search-cell-muted-label"/>
                    <Label fx:id="toCityDisplay" text="" styleClass="search-cell-value-label"/>
                    <Label fx:id="toSubDisplay" text="" styleClass="search-cell-sub-label"/>
                    <!-- Invisible ComboBox for logic freeze compatibility -->
                    <ComboBox fx:id="toCombo" visible="false" managed="false" minHeight="0" prefHeight="0" maxHeight="0"/>
                </VBox>

                <!-- DEPARTURE Cell -->
                <VBox alignment="CENTER_LEFT" spacing="3" styleClass="search-cell, search-cell-border" HBox.hgrow="ALWAYS" prefWidth="180">
                    <Label text="Departure" styleClass="search-cell-muted-label"/>
                    <Label fx:id="depDateDisplay" text="" styleClass="search-cell-value-label"/>
                    <Label fx:id="depDayDisplay" text="" styleClass="search-cell-sub-label"/>
                    <!-- Invisible DatePicker for logic freeze compatibility -->
                    <DatePicker fx:id="departureDatePicker" visible="false" managed="false" minHeight="0" prefHeight="0" maxHeight="0"/>
                </VBox>

                <!-- RETURN Cell (hidden: one-way flights only, kept for fx:id compatibility) -->
                <VBox fx:id="returnCard" visible="false" managed="false" alignment="CENTER_LEFT" spacing="3" styleClass="search-cell, search-cell-border">
                    <Label text="Return" styleClass="search-cell-muted-label"/>
                    <Label fx:id="returnValueDisplay" text="One way" styleClass="search-cell-value-label"/>
                </VBox>

                <!-- TRAVELLERS AND CLASS Cell -->
                <VBox fx:id="travellersCard" alignment="CENTER_LEFT" spacing="3" styleClass="search-cell" HBox.hgrow="ALWAYS" prefWidth="200">
                    <Label text="Travellers and class" styleClass="search-cell-muted-label"/>
                    <Label fx:id="travellersValueDisplay" text="1 Traveller" styleClass="search-cell-value-label"/>
                    <Label text="Economy" styleClass="search-cell-sub-label"/>
                    <!-- Invisible Passengers ComboBox for logic freeze compatibility -->
                    <ComboBox fx:id="passengersCombo" visible="false" managed="false" minHeight="0" prefHeight="0" maxHeight="0"/>
                </VBox>

                <!-- WHITE SEARCH BUTTON (84 wide, vertical gradient -glass-cream to -glass-cream) -->
                <Button fx:id="searchButton" onAction="#handleSearch" styleClass="search-btn-gold">
                    <graphic>
                        <SVGPath content="M11 4.5 A 6.5 6.5 0 1 0 11 17.5 A 6.5 6.5 0 1 0 11 4.5 M 16 16 L 21 21"
                                 styleClass="search-btn-icon"/>
                    </graphic>
                </Button>
            </HBox>

            <!-- ==============================================================-
                 BOTTOM WORKSPACE: FILTERS (width 300) + RESULTS (flex-grow)
                 ==============================================================- -->
            <HBox spacing="16" VBox.vgrow="ALWAYS" minHeight="0">

                <!-- FILTERS SIDEBAR (width 300) -->
                <VBox styleClass="filters-panel" minWidth="300" prefWidth="300" maxWidth="300" spacing="10">
                    <Label fx:id="filtersTitleLabel" text="Filters" styleClass="filters-title"/>

                    <VBox fx:id="filtersCard" styleClass="filters-card" minWidth="300" prefWidth="300" maxWidth="300" VBox.vgrow="ALWAYS" spacing="16">

                        <!-- Section: Departure (2x2 pills) -->
                        <VBox spacing="10">
                            <Label text="Departure" styleClass="filter-section-title"/>
                            <GridPane hgap="8" vgap="8">
                                <Button text="Before 6 AM" onAction="#handleFilterDeparture"
                                        styleClass="pill-button" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Button text="6 AM to 12 PM" onAction="#handleFilterDeparture"
                                        styleClass="pill-button" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Button text="12 PM to 6 PM" onAction="#handleFilterDeparture"
                                        styleClass="pill-button" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Button text="After 6 PM" onAction="#handleFilterDeparture"
                                        styleClass="pill-button" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            </GridPane>
                        </VBox>

                        <!-- Section: Price (range slider) -->
                        <VBox fx:id="priceFilterSection" spacing="8">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Price" styleClass="filter-section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Reset" onAction="#handleResetPrice" styleClass="filter-reset-link"/>
                            </HBox>
                            <Label fx:id="priceFilterValueLabel" text="Max price: R 0" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                            <Slider fx:id="priceSlider" minWidth="264" prefWidth="264" maxWidth="264" styleClass="glass-slider"/>
                            <Label fx:id="priceSingleValueLabel" text="" visible="false" managed="false" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #ffffff;"/>
                        </VBox>

                        <!-- Section: Flight duration (range slider) -->
                        <VBox fx:id="durationFilterSection" spacing="8">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Flight duration" styleClass="filter-section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Reset" onAction="#handleResetDuration" styleClass="filter-reset-link"/>
                            </HBox>
                            <Label fx:id="durationFilterValueLabel" text="Max duration: 0h 00m" style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.75);"/>
                            <Slider fx:id="durationSlider" minWidth="264" prefWidth="264" maxWidth="264" styleClass="glass-slider"/>
                            <Label fx:id="durationSingleValueLabel" text="" visible="false" managed="false" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #ffffff;"/>
                        </VBox>

                        <!-- Section: Cabin (two rows) -->
                        <VBox spacing="10">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Cabin" styleClass="filter-section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Reset" onAction="#handleResetCabin" styleClass="filter-reset-link"/>
                            </HBox>
                            <VBox spacing="10">
                                <HBox fx:id="economyCabinRow" alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleCabinRowEconomy" styleClass="cabin-check-row">
                                    <StackPane fx:id="economyCheckCircle" styleClass="check-circle">
                                        <SVGPath content="M5 12l5 5 9-10" styleClass="check-tick-icon"/>
                                    </StackPane>
                                    <Label fx:id="economyCabinLabel" text="Economy · 0 flights" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #ffffff;"/>
                                </HBox>

                                <HBox fx:id="firstCabinRow" alignment="CENTER_LEFT" spacing="10" onMouseClicked="#handleCabinRowFirst" styleClass="cabin-check-row">
                                    <StackPane fx:id="firstClassCheckCircle" styleClass="check-circle">
                                        <SVGPath content="M5 12l5 5 9-10" styleClass="check-tick-icon"/>
                                    </StackPane>
                                    <Label fx:id="firstCabinLabel" text="First Class · 0 flights" style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #ffffff;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                    </VBox>
                </VBox>

                <!-- RESULTS COLUMN (flex-grow) -->
                <VBox spacing="10" HBox.hgrow="ALWAYS">

                    <!-- Header Row: Origin to Dest title + showing count -->
                    <HBox alignment="BASELINE_LEFT" spacing="10" style="-fx-padding: 2px 4px;" HBox.hgrow="ALWAYS">
                        <Label fx:id="resultsTitleLabel" text="Flights" styleClass="results-header-title" minWidth="-Infinity"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="resultsCountLabel" text="" styleClass="results-header-count" minWidth="-Infinity" visible="false"/>
                    </HBox>

                    <!-- Interactive Glass Result Cards Container -->
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="glass-scroll-pane" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                        <VBox fx:id="resultsCardsContainer" spacing="10" HBox.hgrow="ALWAYS">
                            <!-- Cards built dynamically by GlassFlightResultsBridge -->
                        </VBox>
                    </ScrollPane>

                    <!-- TableView Bridge: maintains full compatibility with FlightSearchController.initTable() -->
                    <GlassFlightResultsBridge fx:id="flightsTable" visible="false" managed="false" minHeight="0" prefHeight="0" maxHeight="0" minWidth="0" prefWidth="0" maxWidth="0" style="-fx-opacity: 0; visibility: hidden; -fx-max-height: 0; -fx-pref-height: 0; -fx-max-width: 0;">
                        <columns>
                            <TableColumn fx:id="flightCol" text="FLIGHT"/>
                            <TableColumn fx:id="departsCol" text="DEPARTS"/>
                            <TableColumn fx:id="arrivesCol" text="ARRIVES"/>
                            <TableColumn fx:id="durationCol" text="DURATION"/>
                            <TableColumn fx:id="fromPriceCol" text="FROM"/>
                            <TableColumn fx:id="actionCol" text="ACTION"/>
                        </columns>
                    </GlassFlightResultsBridge>

                </VBox>
            </HBox>

        </VBox>

    </VBox>

</GlassBackground>
