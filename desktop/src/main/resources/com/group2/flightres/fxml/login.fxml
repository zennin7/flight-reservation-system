<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group2.flightres.controller.LoginController"
      styleClass="login-split-root"
      alignment="CENTER_LEFT"
      prefWidth="1000"
      prefHeight="676">

    <!-- Left: Photographic Showcase with Table Mountain aerial airplane window -->
    <StackPane prefWidth="440" minWidth="440" maxWidth="440" prefHeight="676">
        <ImageView fitWidth="440" fitHeight="676" preserveRatio="false">
            <image>
                <Image url="@../photos/login-side.jpg"/>
            </image>
        </ImageView>
        <Region styleClass="login-photo-overlay" prefWidth="440" prefHeight="676"/>
        <VBox alignment="BOTTOM_LEFT" spacing="6">
            <StackPane.margin>
                <Insets left="32" right="32" bottom="36"/>
            </StackPane.margin>
            <Label text="FLY ABOVE THE ORDINARY" styleClass="login-tagline-caps"/>
            <Label text="Experience South Africa from new heights with refined comfort and seamless booking."
                   styleClass="login-photo-quote" wrapText="true" maxWidth="360"/>
        </VBox>
    </StackPane>

    <!-- Right: Elevated Authentication Form -->
    <StackPane HBox.hgrow="ALWAYS" alignment="CENTER" prefHeight="676">
        <VBox alignment="TOP_CENTER" spacing="16" maxWidth="360" maxHeight="-Infinity" styleClass="card, login-card">
            <!-- Title & Subtitle -->
            <VBox alignment="CENTER" spacing="4">
                <Label text="Welcome back" styleClass="login-card-title" />
                <Label text="Log in to book and manage your flights" styleClass="login-card-subtitle" />
            </VBox>

            <!-- Username Field -->
            <VBox spacing="4" alignment="TOP_LEFT">
                <Label text="Username" styleClass="login-field-label" />
                <TextField fx:id="usernameField" promptText="Username" styleClass="text-field" />
            </VBox>

            <!-- Password Field -->
            <VBox spacing="4" alignment="TOP_LEFT">
                <Label text="Password" styleClass="login-field-label" />
                <PasswordField fx:id="passwordField" promptText="Password" styleClass="password-field" />
            </VBox>

            <!-- Remember Me CheckBox -->
            <HBox alignment="CENTER_LEFT">
                <CheckBox fx:id="rememberMeCheckBox" text="Remember me" styleClass="remember-me-checkbox" />
            </HBox>

            <!-- Error Label (hidden until login fails) -->
            <Label fx:id="errorLabel"
                   text="Incorrect username or password."
                   styleClass="login-error-text"
                   visible="false"
                   managed="false"
                   wrapText="true" />

            <!-- Log In Button -->
            <Button fx:id="loginButton"
                    text="Log In"
                    onAction="#handleLogin"
                    styleClass="btn-gold, login-submit-btn"
                    maxWidth="Infinity" />
        </VBox>
    </StackPane>

</HBox>
