<?xml version="1.0" encoding="UTF-8"?>

<?import com.group2.flightres.config.BrandConfig?>
<?import com.group2.flightres.util.GlassBackground?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<GlassBackground xmlns="http://javafx.com/javafx"
                 xmlns:fx="http://javafx.com/fxml"
                 fx:controller="com.group2.flightres.controller.HomeController"
                 photoPath="/com/group2/flightres/photos/aerial-1.jpg"
                 blurRadius="18.0"
                 darkness="-0.45"
                 saturation="0.08"
                 linearOverlay="linear-gradient(to bottom, rgba(13,28,36,0.42) 0%, rgba(18,23,29,0.84) 100%)"
                 radialGlow="radial-gradient(center 20% 10%, radius 55%, rgba(241, 238, 223, 0.14) 0%, transparent 100%)"
                 enableSecondaryGlow="false"
                 stylesheets="@../css/glass.css"
                 styleClass="home-root"
                 prefWidth="1280"
                 prefHeight="800"
                 minWidth="1024"
                 minHeight="700">

    <VBox alignment="CENTER" spacing="28" maxWidth="1040">
        <padding>
            <Insets top="36" right="48" bottom="36" left="48"/>
        </padding>

        <!-- Hero Copy -->
        <VBox alignment="CENTER_LEFT" spacing="10" maxWidth="960">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <SVGPath content="M3 13l18-8-6 16-3-7-9-1z" styleClass="brand-plane-icon"/>
                <Label styleClass="home-hero-kicker">
                    <text><BrandConfig fx:constant="APP_NAME"/></text>
                </Label>
            </HBox>
            <Label text="Fly higher." styleClass="home-hero-headline"/>
            <Label text="Compare live fares, pick your seat, and travel across South Africa with confidence."
                   styleClass="home-hero-sub"
                   wrapText="true"
                   maxWidth="540"/>
        </VBox>

        <!-- Frosted Glass Search Card -->
        <HBox alignment="BOTTOM_CENTER" spacing="14" styleClass="home-glass-card" maxWidth="960">
            <!-- FROM -->
            <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="180" prefWidth="210">
                <Label text="FROM" styleClass="home-field-label"/>
                <ComboBox fx:id="fromCombo" maxWidth="Infinity" styleClass="home-glass-input"/>
            </VBox>

            <!-- TO -->
            <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="180" prefWidth="210">
                <Label text="TO" styleClass="home-field-label"/>
                <ComboBox fx:id="toCombo" maxWidth="Infinity" styleClass="home-glass-input"/>
            </VBox>

            <!-- DEPARTURE DATE -->
            <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="150" prefWidth="170">
                <Label text="DEPARTURE" styleClass="home-field-label"/>
                <DatePicker fx:id="departureDatePicker" promptText="Select date" maxWidth="Infinity" styleClass="home-glass-input"/>
            </VBox>

            <!-- RETURN DATE (hidden: one-way flights only, kept for fx:id compatibility) -->
            <VBox visible="false" managed="false">
                <DatePicker fx:id="returnDatePicker" visible="false" managed="false"/>
            </VBox>

            <!-- PASSENGERS -->
            <VBox spacing="6" minWidth="120" prefWidth="135">
                <Label text="TRAVELLERS" styleClass="home-field-label"/>
                <ComboBox fx:id="passengersCombo" maxWidth="Infinity" styleClass="home-glass-input"/>
            </VBox>

            <!-- WHITE PILL SEARCH BUTTON -->
            <Button fx:id="searchFlightsButton" text="Search Flights" styleClass="btn-primary-pill" minWidth="168" prefWidth="168">
                <graphic>
                    <SVGPath content="M 7 2.5 A 4.5 4.5 0 1 0 7 11.5 A 4.5 4.5 0 1 0 7 2.5 M 10.2 10.2 L 15 15"
                             styleClass="search-btn-icon"/>
                </graphic>
            </Button>
        </HBox>

        <!-- 4 Glass Feature Cards -->
        <HBox alignment="CENTER" spacing="14" maxWidth="960">
            <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS" styleClass="home-feature-glass">
                <StackPane styleClass="home-feature-icon-circle">
                    <SVGPath content="M3 21 L35 4 L38 7 L26 16 L28 28 L24 29 L18 19 L9 24 L6 22 Z"
                             styleClass="home-feature-icon" scaleX="0.45" scaleY="0.45"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Transparent Fares" styleClass="home-feature-title"/>
                    <Label text="Live pricing across Economy and First." styleClass="home-feature-desc" wrapText="true" maxWidth="165"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS" styleClass="home-feature-glass">
                <StackPane styleClass="home-feature-icon-circle">
                    <SVGPath content="M 12 2 L 4 5 L 4 11 C 4 16.5 7.5 21.5 12 22.8 C 16.5 21.5 20 16.5 20 11 L 20 5 Z"
                             styleClass="home-feature-icon" scaleX="0.75" scaleY="0.75"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Reserved Seats" styleClass="home-feature-title"/>
                    <Label text="Live 5-minute seat holds during checkout." styleClass="home-feature-desc" wrapText="true" maxWidth="165"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS" styleClass="home-feature-glass">
                <StackPane styleClass="home-feature-icon-circle">
                    <SVGPath content="M 4 6 H 20 V 18 H 4 Z M 4 10 H 20"
                             styleClass="home-feature-icon" scaleX="0.75" scaleY="0.75"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Instant Boarding Pass" styleClass="home-feature-title"/>
                    <Label text="Digital ticket with scannable QR code." styleClass="home-feature-desc" wrapText="true" maxWidth="165"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS" styleClass="home-feature-glass">
                <StackPane styleClass="home-feature-icon-circle">
                    <SVGPath content="M 12 2 C 7.6 2 4 5.6 4 10 C 4 15.2 12 22 12 22 C 12 22 20 15.2 20 10 C 20 5.6 16.4 2 12 2 Z"
                             styleClass="home-feature-icon" scaleX="0.75" scaleY="0.75"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="South Africa" styleClass="home-feature-title"/>
                    <Label text="Daily flights connecting JNB, CPT, and DUR." styleClass="home-feature-desc" wrapText="true" maxWidth="165"/>
                </VBox>
            </HBox>
        </HBox>
    </VBox>

</GlassBackground>
