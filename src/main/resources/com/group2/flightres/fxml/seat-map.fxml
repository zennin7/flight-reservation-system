<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.group2.flightres.controller.SeatMapController"
      spacing="20"
      alignment="TOP_CENTER"
      styleClass="seat-map-root">

    <!-- Left Card: Seat Grid & Legend -->
    <VBox HBox.hgrow="ALWAYS" styleClass="card, seat-grid-card" spacing="8" alignment="TOP_CENTER">
        <!-- Title & Fallback Notice -->
        <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
            <Label fx:id="flightTitleLabel"
                   text="Choose your seat · GRP 204 JNB ➔ CPT"
                   styleClass="seat-map-title" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="fallbackNoticeLabel"
                   text="Showing sample seats, database unavailable"
                   styleClass="fallback-notice-label"
                   visible="false" managed="false" />
        </HBox>

        <!-- Cabin Area -->
        <VBox fx:id="cabinContainer" alignment="TOP_CENTER" spacing="6">
            <!-- Programmatically populated First Class 2x2 and Economy 3x3 -->
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <!-- Bottom Legend -->
        <HBox alignment="CENTER" spacing="18" styleClass="seat-legend-box">
            <HBox alignment="CENTER" spacing="6">
                <Region styleClass="legend-swatch, legend-available" />
                <Label text="Available" styleClass="legend-label" />
            </HBox>
            <HBox alignment="CENTER" spacing="6">
                <Region styleClass="legend-swatch, legend-selected" />
                <Label text="Your selection" styleClass="legend-label" />
            </HBox>
            <HBox alignment="CENTER" spacing="6">
                <Region styleClass="legend-swatch, legend-taken" />
                <Label text="Taken" styleClass="legend-label" />
            </HBox>
        </HBox>
    </VBox>

    <!-- Right Card: Selection Summary & Actions -->
    <VBox styleClass="card, seat-selection-card" minWidth="270" prefWidth="270" maxWidth="270" spacing="12">
        <Label text="Your selection" styleClass="selection-card-title" />

        <HBox alignment="CENTER_LEFT">
            <Label text="Seat" styleClass="selection-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="seatSelectionLabel" text="7E · Economy" styleClass="selection-val-bold" />
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <Label text="Base fare" styleClass="selection-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="baseFareLabel" text="R 1,200" styleClass="selection-val-bold" />
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <Label text="Class multiplier" styleClass="selection-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="classMultiplierLabel" text="x 1.0" styleClass="selection-val-bold" />
        </HBox>

        <HBox alignment="CENTER_LEFT">
            <Label text="Demand pricing" styleClass="selection-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="demandPricingLabel" text="+ R 180" styleClass="selection-val-bold" />
        </HBox>

        <!-- Divider -->
        <Region styleClass="selection-divider" />

        <!-- Total Row -->
        <HBox alignment="CENTER_LEFT">
            <Label text="Total" styleClass="selection-total-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Label fx:id="totalPriceLabel" text="R 1,380" styleClass="selection-total-val" />
        </HBox>

        <Label text="Hover any seat to see its price. Seats are held for 10 minutes."
               wrapText="true"
               styleClass="selection-hint-label" />

        <!-- Buttons at Bottom -->
        <VBox spacing="10" alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS">
            <Button fx:id="continueButton"
                    text="Continue to Checkout"
                    onAction="#handleContinue"
                    maxWidth="Infinity"
                    styleClass="btn-gold, continue-checkout-btn" />
            <Button fx:id="backButton"
                    text="Back"
                    onAction="#handleBack"
                    maxWidth="Infinity"
                    styleClass="btn-grey, back-btn" />
        </VBox>
    </VBox>

</HBox>
